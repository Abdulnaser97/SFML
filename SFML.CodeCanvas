					"diagramNodeId": "0ecf52d1-f5f0-449a-b1a6-970329d5899e",
					"simStepLabel": "Enter Game Loop",
					"simStepDescription": "The program enters the main game loop. In each iteration (frame), the clock is used to calculate the time elapsed since the previous iteration.",
					"isEdge": 1,
					"sourceCodeMapping": {
