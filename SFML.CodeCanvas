		"Render 2D graphics like sprites, shapes, and text": {
			"name": "Render 2D graphics like sprites, shapes, and text",
			"simSteps": [
				{
					"simStepId": "2abd29f2-f83a-4a95-b205-e1ae21abf23e",
					"diagramNodeId": "479535b8-753e-48d4-b117-8d11b1064299",
					"simStepLabel": "Render Sprite Flow: Load Texture",
					"simStepDescription": "A `sf::Texture` object is created by loading an image from a file. This process involves reading the file from disk, decoding the image format (e.g., PNG, JPG), and uploading the raw pixel data to the GPU's memory for efficient rendering.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Texture.hpp",
						"startLine": "120",
						"endLine": "120",
						"relevantVariables": [
							"Texture::Texture"
						]
					},
					"inputDataExample": "{\"filename\": \"resources/logo.png\", \"sRgb\": false}",
					"outputDataExample": "{\"textureObject\": {\"size\": {\"x\": 512, \"y\": 512}, \"isSmooth\": false, \"nativeHandle\": 1}}"
				},
				{
					"simStepId": "ae8c7d0f-bc08-4fac-a148-4bf4bbb5c01f",
					"diagramNodeId": "5fd6ccd7-d607-408d-aa41-dbb1980dea5f",
					"simStepLabel": "Render Sprite Flow: Pass Texture to Sprite",
					"simStepDescription": "The newly created `sf::Texture` object is passed by reference to the constructor of an `sf::Sprite`. The sprite does not copy the texture data; it only stores a pointer to the texture object.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Sprite.hpp",
						"startLine": "57",
						"endLine": "57",
						"relevantVariables": [
							"Sprite::Sprite",
							"texture"
						]
					},
					"inputDataExample": "{\"textureObject\": {\"size\": {\"x\": 512, \"y\": 512}, \"isSmooth\": false, \"nativeHandle\": 1}}",
					"outputDataExample": "{\"textureObject\": {\"size\": {\"x\": 512, \"y\": 512}, \"isSmooth\": false, \"nativeHandle\": 1}}"
				},
				{
					"simStepId": "a3f6b0f3-fe59-4514-aa39-1f1555bf3c75",
					"diagramNodeId": "dd22cb94-f4c2-48b0-a266-d72e13055fd2",
					"simStepLabel": "Render Sprite Flow: Create Sprite",
					"simStepDescription": "An `sf::Sprite` object is instantiated. It acts as a lightweight object that can be drawn to the screen. Internally, it holds the pointer to its texture and defines a geometric shape (a quad of 4 vertices) that maps to the texture or a sub-rectangle of it.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Sprite.hpp",
						"startLine": "57",
						"endLine": "57",
						"relevantVariables": [
							"Sprite::Sprite"
						]
					},
					"inputDataExample": "{\"texture\": {\"size\": {\"x\": 512, \"y\": 512}, \"nativeHandle\": 1}}",
					"outputDataExample": "{\"spriteObject\": {\"texturePtr\": \"0xABC123\", \"textureRect\": {\"left\": 0, \"top\": 0, \"width\": 512, \"height\": 512}, \"color\": \"0xFFFFFFFF\", \"position\": {\"x\": 100, \"y\": 150}}}"
				},
				{
					"simStepId": "79efd789-1af7-4761-8c10-5d7c6dd7e41b",
					"diagramNodeId": "2c2437a4-0109-4259-96a6-1769ffdb89df",
					"simStepLabel": "Render Sprite Flow: Pass Sprite to `window.draw`",
					"simStepDescription": "The `sf::Sprite` object, which is a `sf::Drawable`, is passed as an argument to the `sf::RenderWindow::draw` method to be rendered in the current frame.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/RenderTarget.hpp",
						"startLine": "297",
						"endLine": "297",
						"relevantVariables": [
							"RenderTarget::draw",
							"drawable"
						]
					},
					"inputDataExample": "{\"drawable\": {\"type\": \"sf::Sprite\", \"texturePtr\": \"0xABC123\"}, \"states\": \"RenderStates::Default\"}",
					"outputDataExample": "{\"drawable\": {\"type\": \"sf::Sprite\", \"texturePtr\": \"0xABC123\"}, \"states\": \"RenderStates::Default\"}"
				},
				{
					"simStepId": "4c64ab82-66bb-40dc-b59e-ba3d8e045755",
					"diagramNodeId": "d919a102-9b4b-4967-86a2-d95f264a0884",
					"simStepLabel": "Render Sprite Flow: Draw Sprite on Render Target",
					"simStepDescription": "The `RenderTarget` (e.g., `sf::RenderWindow`) invokes the sprite's own `draw` method. This method applies the sprite's transformations (position, rotation, scale) to its vertices, sets the appropriate render states (including binding its texture), and issues a command to the GPU to draw the vertices.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Sprite.hpp",
						"startLine": "211",
						"endLine": "211",
						"relevantVariables": [
							"Sprite::draw"
						]
					},
					"inputDataExample": "{\"target\": \"sf::RenderWindow\", \"states\": {\"transform\": \"...\", \"texture\": \"0xABC123\"}}",
					"outputDataExample": "{\"status\": \"Sprite's vertices are processed by the GPU and rasterized into pixels in the window's back buffer.\"}"
				},
				{
					"simStepId": "17f1f2bc-183c-4479-aef4-f7f73ba8648a",
					"diagramNodeId": "82467da7-812c-4c91-be3f-0cfc32d37098",
					"simStepLabel": "Render Text Flow: Load Font",
					"simStepDescription": "A `sf::Font` object is created by loading a font file (e.g., TTF). This initializes the FreeType font library, parses the font file, and makes the font's metadata and glyph data available for rendering.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Font.hpp",
						"startLine": "101",
						"endLine": "101",
						"relevantVariables": [
							"Font::Font"
						]
					},
					"inputDataExample": "{\"filename\": \"resources/tuffy.ttf\"}",
					"outputDataExample": "{\"fontObject\": {\"info\": {\"family\": \"Tuffy\", \"hasKerning\": true}, \"internalFacePtr\": \"0xDEF456\"}}"
				},
				{
					"simStepId": "2f9e7982-219f-4d80-992f-b33012863dc6",
					"diagramNodeId": "218702ac-6103-4d7a-b5be-105f51268f84",
					"simStepLabel": "Render Text Flow: Pass Font to Text Object",
					"simStepDescription": "The loaded `sf::Font` object is passed by reference to the constructor of an `sf::Text` object, along with the string to be displayed and character size. The text object will use this font to generate its visual representation.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Text.hpp",
						"startLine": "159",
						"endLine": "159",
						"relevantVariables": [
							"Text::Text",
							"font",
							"string"
						]
					},
					"inputDataExample": "{\"font\": {\"info\": {\"family\": \"Tuffy\"}}, \"string\": \"Hello SFML\", \"characterSize\": 50}",
					"outputDataExample": "{\"font\": {\"info\": {\"family\": \"Tuffy\"}}, \"string\": \"Hello SFML\", \"characterSize\": 50}"
				},
				{
					"simStepId": "f618fa92-08b0-42a9-b324-2d8e245b9716",
					"diagramNodeId": "f2347687-d63d-4bfb-94dd-e2f444ab4449",
					"simStepLabel": "Render Text Flow: Create Text and Generate Geometry",
					"simStepDescription": "An `sf::Text` object is created. It uses the provided font to process the input string. For each character, it requests the corresponding glyph from the `sf::Font`. The font rasterizes the glyph if it's not already available and stores it in an internal texture atlas. The `sf::Text` object then computes the vertices and texture coordinates for all glyphs to form the final text geometry.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Text.hpp",
						"startLine": "159",
						"endLine": "159",
						"relevantVariables": [
							"Text::Text"
						]
					},
					"inputDataExample": "{\"font\": {\"info\": {\"family\": \"Tuffy\"}}, \"string\": \"Hello SFML\", \"characterSize\": 50}",
					"outputDataExample": "{\"textObject\": {\"fontPtr\": \"0xDEF456\", \"string\": \"Hello SFML\", \"characterSize\": 50, \"fillColor\": \"0xFFFFFFFF\", \"vertexCount\": 40}}"
				},
				{
					"simStepId": "0b3b04bd-e422-4a25-b8e5-c406a9bf8bab",
					"diagramNodeId": "82e3cee2-7d4c-45c8-9f78-83f2aa53247e",
					"simStepLabel": "Render Text Flow: Pass Text to `window.draw`",
					"simStepDescription": "The fully formed `sf::Text` object, which is a `sf::Drawable`, is passed as an argument to the `sf::RenderWindow::draw` method for rendering.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/RenderTarget.hpp",
						"startLine": "297",
						"endLine": "297",
						"relevantVariables": [
							"RenderTarget::draw",
							"drawable"
						]
					},
					"inputDataExample": "{\"drawable\": {\"type\": \"sf::Text\", \"string\": \"Hello SFML\"}, \"states\": \"RenderStates::Default\"}",
					"outputDataExample": "{\"drawable\": {\"type\": \"sf::Text\", \"string\": \"Hello SFML\"}, \"states\": \"RenderStates::Default\"}"
				},
				{
					"simStepId": "cf6a31ef-a651-4a70-8c04-3d7e6e45f57a",
					"diagramNodeId": "9fa07ae8-4ada-4614-bf05-785572eec26c",
					"simStepLabel": "Render Text Flow: Draw Text on Render Target",
					"simStepDescription": "The `RenderTarget` calls the `sf::Text` object's virtual `draw` method. This method sets the render states, including binding the font's internal glyph texture atlas, and issues a GPU command to draw the text's vertices.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Drawable.hpp",
						"startLine": "76",
						"endLine": "76",
						"relevantVariables": [
							"Drawable::draw"
						]
					},
					"inputDataExample": "{\"target\": \"sf::RenderWindow\", \"states\": {\"texture\": \"font_glyph_atlas_texture\"}}",
					"outputDataExample": "{\"status\": \"Text vertices are rendered to the window's back buffer.\"}"
				},
				{
					"simStepId": "1bd71095-ed6b-4ceb-bb21-6f791111b48c",
					"diagramNodeId": "eb2bcac1-8c99-4fc2-8b7b-1e6b2d5e778f",
					"simStepLabel": "Render Shape Flow: Create Shape",
					"simStepDescription": "A concrete shape object, such as `sf::RectangleShape`, is instantiated. The constructor initializes its geometric properties (e.g., size). The base `sf::Shape` class manages common properties like color and texture, as well as the internal vertex array.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/RectangleShape.hpp",
						"startLine": "51",
						"endLine": "51",
						"relevantVariables": [
							"RectangleShape::RectangleShape"
						]
					},
					"inputDataExample": "{\"size\": {\"x\": 100.0, \"y\": 50.0}}",
					"outputDataExample": "{\"shapeObject\": {\"size\": {\"x\": 100.0, \"y\": 50.0}, \"fillColor\": \"0xFFFFFFFF\", \"pointCount\": 4}}"
				},
				{
					"simStepId": "218afc8d-95b6-4c58-a7bb-8ebfe8714600",
					"diagramNodeId": "4422f8cf-8720-4c25-9dd1-005ceaff6894",
					"simStepLabel": "Render Shape Flow: Set Shape Fill Color",
					"simStepDescription": "A `sf::Color` value is passed to the shape's `setFillColor` method to change its appearance.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Shape.hpp",
						"startLine": "110",
						"endLine": "110",
						"relevantVariables": [
							"Shape::setFillColor",
							"color"
						]
					},
					"inputDataExample": "{\"color\": {\"r\": 255, \"g\": 0, \"b\": 0, \"a\": 255}}",
					"outputDataExample": "{\"color\": {\"r\": 255, \"g\": 0, \"b\": 0, \"a\": 255}}"
				},
				{
					"simStepId": "22421510-6e25-411b-99a5-67c8862d8c00",
					"diagramNodeId": "c981ee26-caaf-452b-84a1-5758b733264d",
					"simStepLabel": "Render Shape Flow: Update Shape's Internal Vertices",
					"simStepDescription": "Calling a method like `setFillColor` updates the corresponding property in the `sf::Shape` base class. This triggers an update of the internal vertex array, changing the color attribute of each vertex that makes up the shape's fill area.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Shape.hpp",
						"startLine": "344",
						"endLine": "347",
						"relevantVariables": [
							"Shape::updateFillColors"
						]
					},
					"inputDataExample": "{\"newFillColor\": \"0xFF0000FF\"}",
					"outputDataExample": "{\"status\": \"Internal vertex array's fill vertex colors updated.\"}"
				},
				{
					"simStepId": "e0516e6a-fa20-47fe-9467-1a2b6e97a8a4",
					"diagramNodeId": "770ea915-2b78-45d7-96fa-0dfd3804e789",
					"simStepLabel": "Render Shape Flow: Pass Shape to `window.draw`",
					"simStepDescription": "The configured `sf::RectangleShape` object is passed to the `sf::RenderWindow::draw` method to be rendered.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/RenderTarget.hpp",
						"startLine": "297",
						"endLine": "297",
						"relevantVariables": [
							"RenderTarget::draw",
							"drawable"
						]
					},
					"inputDataExample": "{\"drawable\": {\"type\": \"sf::RectangleShape\", \"size\": {\"x\": 100, \"y\": 50}}, \"states\": \"RenderStates::Default\"}",
					"outputDataExample": "{\"drawable\": {\"type\": \"sf::RectangleShape\", \"size\": {\"x\": 100, \"y\": 50}}, \"states\": \"RenderStates::Default\"}"
				},
				{
					"simStepId": "2e122a80-8632-4b4d-afc1-97927f67ae87",
					"diagramNodeId": "df4f0b98-0841-4501-9389-1317caf9cc03",
					"simStepLabel": "Render Shape Flow: Draw Shape on Render Target",
					"simStepDescription": "The `RenderTarget` calls the shape's `draw` method. This method draws the vertices for the shape's fill area and, if an outline is defined, also draws the vertices for the outline.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Graphics/Shape.hpp",
						"startLine": "340",
						"endLine": "340",
						"relevantVariables": [
							"Shape::draw"
						]
					},
					"inputDataExample": "{\"target\": \"sf::RenderWindow\", \"states\": {\"transform\": \"...\", \"texture\": null}}",
					"outputDataExample": "{\"status\": \"Shape's vertices are rendered to the window's back buffer.\"}"
				}
			],
			"description": "<ul><li>This is the core graphics functionality of SFML, enabling developers to draw a wide variety of 2D entities to the screen</li><li>- Load image files into <code>sf::Texture</code> objects and display them using <code>sf::Sprite</code></li><li>- Draw primitive geometric shapes such as <code>sf::RectangleShape</code> and <code>sf::CircleShape</code></li><li>- Load font files (<code>sf::Font</code>) to render and display dynamic text using <code>sf::Text</code></li><li>- Manipulate the position, rotation, and scale of any drawable object through the <code>sf::Transformable</code> interface</li></ul>",
			"simulationNodesAndEdges": {
