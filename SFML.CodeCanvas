		"67d833cd-25d8-41ef-bd58-160e2f50a960": {
			"path": "67d833cd-25d8-41ef-bd58-160e2f50a960",
			"cellName": "Time.hpp",
			"cellId": "67d833cd-25d8-41ef-bd58-160e2f50a960",
			"visible": true,
			"parentCellId": "e3730724-c973-4a69-9fa9-894b20e0a459"
		},
		"af092811-2a7e-4734-8443-558b4f16495f": {
			"path": "af092811-2a7e-4734-8443-558b4f16495f",
			"cellName": "Initialize Clock - Tennis.cpp:L112",
			"cellId": "af092811-2a7e-4734-8443-558b4f16495f",
			"visible": true,
			"parentCellId": "375d9713-4499-4c06-8630-3364d95ebb0e"
		},
		"examples/tennis/Tennis.cpp-simstep-c2a13a4d-fcc2-47b1-a6e5-d69871065c7f": {
			"path": "examples/tennis/Tennis.cpp-simstep-c2a13a4d-fcc2-47b1-a6e5-d69871065c7f",
			"fileName": "Tennis.cpp",
			"wiki": "A `sf::Clock` instance is created before the main game loop begins. This object starts measuring time from the moment of its creation.",
			"cellName": "Initialize Clock - Tennis.cpp:L112",
			"cellId": "af092811-2a7e-4734-8443-558b4f16495f",
			"visible": true,
			"startLine": 112,
			"endLine": 112,
			"parentCellId": "375d9713-4499-4c06-8630-3364d95ebb0e",
			"parentPath": "examples/tennis/Tennis.cpp"
		},
		"47df2e07-9f42-4884-89b3-4752b468ce53": {
			"path": "47df2e07-9f42-4884-89b3-4752b468ce53",
			"cellName": "Get Frame Time and Restart Clock - Clock.cpp:L68-76",
			"cellId": "47df2e07-9f42-4884-89b3-4752b468ce53",
			"visible": true,
			"parentCellId": "e4db87ce-55fe-48d9-9ce9-0239dfa571ef"
		},
		"src/SFML/System/Clock.cpp-simstep-32c95018-f844-494d-99e8-5b1676b72e9f": {
			"path": "src/SFML/System/Clock.cpp-simstep-32c95018-f844-494d-99e8-5b1676b72e9f",
			"fileName": "Clock.cpp",
			"wiki": "The `clock.restart()` method is called. It calculates the time elapsed since the clock was last restarted (or created), returns this duration as an `sf::Time` object, and resets its internal start point to the current time. This is a common pattern to get the delta time for a single frame.",
			"cellName": "Get Frame Time and Restart Clock - Clock.cpp:L68-76",
			"cellId": "47df2e07-9f42-4884-89b3-4752b468ce53",
			"visible": true,
			"startLine": 68,
			"endLine": 76,
			"parentCellId": "e4db87ce-55fe-48d9-9ce9-0239dfa571ef",
			"parentPath": "src/SFML/System/Clock.cpp"
		},
		"030bf8ba-42c2-4526-b4fa-6b953a7a93ac": {
			"path": "030bf8ba-42c2-4526-b4fa-6b953a7a93ac",
			"cellName": "Convert Time to Seconds - Time.hpp:L63-68",
			"cellId": "030bf8ba-42c2-4526-b4fa-6b953a7a93ac",
			"visible": true,
			"parentCellId": "67d833cd-25d8-41ef-bd58-160e2f50a960"
		},
		"include/SFML/System/Time.hpp-simstep-f6776568-6b25-4781-b146-50faa0028f1e": {
			"path": "include/SFML/System/Time.hpp-simstep-f6776568-6b25-4781-b146-50faa0028f1e",
			"fileName": "Time.hpp",
			"wiki": "The `.asSeconds()` method is called on the `sf::Time` object. This converts the duration, internally stored in microseconds, into a floating-point number representing the equivalent time in seconds. This float value is ideal for physics and animation calculations.",
			"cellName": "Convert Time to Seconds - Time.hpp:L63-68",
			"cellId": "030bf8ba-42c2-4526-b4fa-6b953a7a93ac",
			"visible": true,
			"startLine": 63,
			"endLine": 68,
			"parentCellId": "67d833cd-25d8-41ef-bd58-160e2f50a960",
			"parentPath": "include/SFML/System/Time.hpp"
		},
		"898b88d1-70cd-4441-a047-eedceb02a31e": {
			"path": "898b88d1-70cd-4441-a047-eedceb02a31e",
			"cellName": "Apply Delta Time to Game Logic - Tennis.cpp:L187-190",
			"cellId": "898b88d1-70cd-4441-a047-eedceb02a31e",
			"visible": true,
			"parentCellId": "375d9713-4499-4c06-8630-3364d95ebb0e"
		},
		"examples/tennis/Tennis.cpp-simstep-5e786162-3d47-4238-8807-3215fa882a81": {
			"path": "examples/tennis/Tennis.cpp-simstep-5e786162-3d47-4238-8807-3215fa882a81",
			"fileName": "Tennis.cpp",
			"wiki": "The `deltaTime` is used to update the position of a game object. By multiplying the object's speed by `deltaTime`, its movement becomes independent of the frame rate, resulting in smooth and consistent motion across different hardware.",
			"cellName": "Apply Delta Time to Game Logic - Tennis.cpp:L187-190",
			"cellId": "898b88d1-70cd-4441-a047-eedceb02a31e",
			"visible": true,
			"startLine": 187,
			"endLine": 190,
			"parentCellId": "375d9713-4499-4c06-8630-3364d95ebb0e",
			"parentPath": "examples/tennis/Tennis.cpp"
		},
		"0ecf52d1-f5f0-449a-b1a6-970329d5899e": {
			"path": "0ecf52d1-f5f0-449a-b1a6-970329d5899e",
			"cellName": "Enter Game\nLoop",
			"cellId": "0ecf52d1-f5f0-449a-b1a6-970329d5899e",
			"visible": true
		},
		"generated-edge-simstep-52fee96d-c9f2-4f9d-b402-889f8c3f88f6-0ecf52d1-f5f0-449a-b1a6-970329d5899e": {
			"path": "generated-edge-simstep-52fee96d-c9f2-4f9d-b402-889f8c3f88f6-0ecf52d1-f5f0-449a-b1a6-970329d5899e",
			"fileName": "Tennis.cpp",
			"cellName": "Enter Game Loop",
			"cellId": "0ecf52d1-f5f0-449a-b1a6-970329d5899e",
			"visible": true,
			"startLine": 114,
