					"outputDataExample": "{\"clock_object\": {\"is_running\": true, \"start_time_microseconds\": 1677628800000000}}"
				},
				{
					"simStepId": "32c95018-f844-494d-99e8-5b1676b72e9f",
					"diagramNodeId": "47df2e07-9f42-4884-89b3-4752b468ce53",
					"simStepLabel": "Get Frame Time and Restart Clock",
					"simStepDescription": "The `clock.restart()` method is called. It calculates the time elapsed since the clock was last restarted (or created), returns this duration as an `sf::Time` object, and resets its internal start point to the current time. This is a common pattern to get the delta time for a single frame.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/System/Clock.cpp",
						"startLine": "68",
						"endLine": "76",
						"relevantVariables": [
							"restart",
							"getElapsedTime",
							"m_refPoint"
						]
					},
					"inputDataExample": "{\"clock_state_before\": {\"reference_point_microseconds\": 1677628800000000, \"current_time_microseconds\": 1677628800016667}}",
					"outputDataExample": "{\"returned_elapsed_time\": {\"microseconds\": 16667}, \"clock_state_after\": {\"reference_point_microseconds\": 1677628800016667}}"
				},
				{
					"simStepId": "93b0cab0-3f01-4700-8a3e-20f6182d5c62",
					"diagramNodeId": "7b63d34e-f18d-4e79-a6b7-10cf87ad54dd",
					"simStepLabel": "Transmit Elapsed Time Object",
					"simStepDescription": "The `sf::Time` object returned by `clock.restart()` is passed on to be converted into a usable unit for game logic.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "examples/tennis/Tennis.cpp",
