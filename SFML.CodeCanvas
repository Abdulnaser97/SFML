					"outputDataExample": "{\"movement_offset\": {\"x\": 0.0, \"y\": 6.6668}, \"new_position\": {\"x\": 780.0, \"y\": 256.6668}}"
				}
			],
			"description": "<ul><li>SFML provides simple tools for time measurement, crucial for creating smooth, frame-rate independent animations and game logic</li><li>- Use <code>sf::Clock</code> to measure the time elapsed between two points, typically between frames in the game loop</li><li>- The <code>getElapsedTime()</code> method returns an <code>sf::Time</code> object, which can be converted to seconds, milliseconds, or microseconds</li><li>- This delta time is used to update game state and physics, ensuring consistent behavior regardless of the computer's speed</li></ul>",
			"simulationNodesAndEdges": {
