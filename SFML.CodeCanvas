		"Implement basic network communication using sockets": {
			"name": "Implement basic network communication using sockets",
			"simSteps": [
				{
					"simStepId": "f4403d51-dce3-45e8-a9c5-bb9f7565280f",
					"diagramNodeId": "ac890c2a-46ee-4bff-8ae9-948534ac824a",
					"simStepLabel": "Server Flow: Create TCP Listener",
					"simStepDescription": "The server application initializes an `sf::TcpListener` to prepare for accepting incoming client connections. This object will be used to listen on a specific network port.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/sockets/TCP.cpp",
						"startLine": "21",
						"endLine": "21",
						"relevantVariables": [
							"listener"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"listener_object\": {\"local_port\": 0, \"is_blocking\": true}}"
				},
				{
					"simStepId": "ce97fc4d-f497-41c4-958c-e7a7e34cf7fc",
					"diagramNodeId": "b77ce97f-a0ed-49a6-8369-e97f23e7e424",
					"simStepLabel": "Server Flow: Listener Ready",
					"simStepDescription": "The created `sf::TcpListener` object is ready to be configured to listen on a network port.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Network/TcpListener.hpp",
						"startLine": "46",
						"endLine": "46",
						"relevantVariables": [
							"TcpListener"
						]
					},
					"inputDataExample": "{\"listener_object\": {\"local_port\": 0, \"is_blocking\": true}}",
					"outputDataExample": "{\"listener_object\": {\"local_port\": 0, \"is_blocking\": true}}"
				},
				{
					"simStepId": "e733e34a-14af-4a9c-955a-b2e8dd030139",
					"diagramNodeId": "214ac8ff-8d59-4115-85c6-b1be00caff59",
					"simStepLabel": "Server Flow: Start Listening on a Port",
					"simStepDescription": "The server calls `listen()` on the `sf::TcpListener` instance, binding it to a specific port and putting it into a state where it can accept new connections.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/sockets/TCP.cpp",
						"startLine": "24",
						"endLine": "25",
						"relevantVariables": [
							"listener.listen",
							"port"
						]
					},
					"inputDataExample": "{\"port\": 55001}",
					"outputDataExample": "{\"status\": \"Done\"}"
				},
				{
					"simStepId": "f9b133f3-f458-45b8-b350-a10282761f6a",
					"diagramNodeId": "603e138b-1185-4393-9e97-59aa7ba12b6b",
					"simStepLabel": "Server Flow: Awaiting Client Connection",
					"simStepDescription": "The listener is now actively listening on the specified port, waiting for a client to initiate a connection.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Network/TcpListener.hpp",
						"startLine": "72",
						"endLine": "83",
						"relevantVariables": [
							"listen"
						]
					},
					"inputDataExample": "{\"listening_on_port\": 55001}",
					"outputDataExample": "{\"listening_on_port\": 55001}"
				},
				{
					"simStepId": "893b1d1c-a529-4082-b04c-677f5f787190",
					"diagramNodeId": "a60d99c1-e1fe-4894-b801-a85aa5faef8a",
					"simStepLabel": "Server Flow: Accept New Connection",
					"simStepDescription": "The server's main loop calls `accept()` on the listener. This is a blocking call that waits until a client connects, and then populates an `sf::TcpSocket` object to handle communication with that client.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/sockets/TCP.cpp",
						"startLine": "28",
						"endLine": "29",
						"relevantVariables": [
							"listener.accept",
							"socket"
						]
					},
					"inputDataExample": "{\"listener\": \"listening sf::TcpListener object\"}",
					"outputDataExample": "{\"status\": \"Done\", \"client_socket\": {\"remote_address\": \"192.168.1.101\", \"remote_port\": 49152}}"
				},
				{
					"simStepId": "1cff158d-bf9e-48a4-a62a-2ac85d8f887c",
					"diagramNodeId": "1f0a824d-27e4-4ab0-a0d3-6bd1a2f61fad",
					"simStepLabel": "Server Flow: Data Transmission (Server to Client)",
					"simStepDescription": "With a client connected, the server sends a welcome message through the newly created TCP socket. The raw string data is transmitted over the network.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Network/TcpSocket.cpp",
						"startLine": "247",
						"endLine": "256",
						"relevantVariables": [
							"::send"
						]
					},
					"inputDataExample": "{\"message\": \"Hi, I'm the server\"}",
					"outputDataExample": "{\"message\": \"Hi, I'm the server\"}"
				},
				{
					"simStepId": "c28c195d-c4b3-4497-bbaf-7feab7c7aea7",
					"diagramNodeId": "1962cefb-3982-4b48-a114-2f3054787def",
					"simStepLabel": "Server Flow: Send Data to Client",
					"simStepDescription": "The server sends a message to the client using `socket.send()`. This function takes a pointer to the data and its size, and attempts to send it through the underlying system socket.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/sockets/TCP.cpp",
						"startLine": "34",
						"endLine": "35",
						"relevantVariables": [
