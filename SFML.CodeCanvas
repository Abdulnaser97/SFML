		"0a3b7921-613e-440e-867d-9a51d8b814c0": {
			"path": "0a3b7921-613e-440e-867d-9a51d8b814c0",
			"cellName": "Event Polling: Application Polls for Events - Window.cpp:L144-145",
			"cellId": "0a3b7921-613e-440e-867d-9a51d8b814c0",
			"visible": true,
			"parentCellId": "409cb91b-9bdd-45e6-8789-06ec635fa04a"
		},
		"examples/window/Window.cpp-simstep-ce2c4e08-6020-4b3d-8882-6269f392d994": {
			"path": "examples/window/Window.cpp-simstep-ce2c4e08-6020-4b3d-8882-6269f392d994",
			"fileName": "Window.cpp",
			"wiki": "The application's main loop continuously calls `window.pollEvent()` to check for and retrieve pending events from the operating system, such as keyboard presses, mouse movements, or window close requests.",
			"cellName": "Event Polling: Application Polls for Events - Window.cpp:L144-145",
			"cellId": "0a3b7921-613e-440e-867d-9a51d8b814c0",
			"visible": true,
			"startLine": 144,
			"endLine": 145,
			"parentCellId": "409cb91b-9bdd-45e6-8789-06ec635fa04a",
			"parentPath": "examples/window/Window.cpp"
		},
		"e06e5bf3-5d3b-44be-95a6-3af785a81834": {
			"path": "e06e5bf3-5d3b-44be-95a6-3af785a81834",
			"cellName": "Event Polling: WindowBase Forwards Poll Request - WindowBase.cpp:L138-147",
			"cellId": "e06e5bf3-5d3b-44be-95a6-3af785a81834",
			"visible": true,
			"parentCellId": "a941e50d-ce2a-4cc7-98dc-135e581080f3"
		},
		"src/SFML/Window/WindowBase.cpp-simstep-a2f2577d-ba8f-433f-953c-1842edaa0f85": {
			"path": "src/SFML/Window/WindowBase.cpp-simstep-a2f2577d-ba8f-433f-953c-1842edaa0f85",
			"fileName": "WindowBase.cpp",
			"wiki": "The `sf::WindowBase::pollEvent()` method delegates the call to its platform-specific implementation (`m_impl`), which handles the direct interaction with the OS windowing system.",
			"cellName": "Event Polling: WindowBase Forwards Poll Request - WindowBase.cpp:L138-147",
			"cellId": "e06e5bf3-5d3b-44be-95a6-3af785a81834",
			"visible": true,
			"startLine": 138,
			"endLine": 147,
			"parentCellId": "a941e50d-ce2a-4cc7-98dc-135e581080f3",
			"parentPath": "src/SFML/Window/WindowBase.cpp"
		},
		"3d9264a5-efa5-491e-a0bb-240d9f4d0a7b": {
			"path": "3d9264a5-efa5-491e-a0bb-240d9f4d0a7b",
			"cellName": "Event Polling: WindowImpl Populates and Polls Event Queue - WindowImpl.cpp:L250-260",
			"cellId": "3d9264a5-efa5-491e-a0bb-240d9f4d0a7b",
			"visible": true,
			"parentCellId": "68858b34-c441-4f4a-afb8-53178f20ad3f"
		},
		"src/SFML/Window/WindowImpl.cpp-simstep-85bb3f1b-e4c7-48f2-8f6d-5d744f034fc7": {
			"path": "src/SFML/Window/WindowImpl.cpp-simstep-85bb3f1b-e4c7-48f2-8f6d-5d744f034fc7",
			"fileName": "WindowImpl.cpp",
			"wiki": "The `WindowImpl::pollEvent()` method first checks if its internal event queue is empty. If so, it calls `populateEventQueue()` to fetch new events from the operating system. It then returns the next event from the front of the queue.",
			"cellName": "Event Polling: WindowImpl Populates and Polls Event Queue - WindowImpl.cpp:L250-260",
			"cellId": "3d9264a5-efa5-491e-a0bb-240d9f4d0a7b",
			"visible": true,
			"startLine": 250,
			"endLine": 260,
			"parentCellId": "68858b34-c441-4f4a-afb8-53178f20ad3f",
			"parentPath": "src/SFML/Window/WindowImpl.cpp"
		},
		"33429860-81eb-45c6-ae04-b56c67b15f8f": {
			"path": "33429860-81eb-45c6-ae04-b56c67b15f8f",
			"cellName": "Event Polling: Platform Translates OS Event to SFML Event - InputImpl.cpp:L376-382",
			"cellId": "33429860-81eb-45c6-ae04-b56c67b15f8f",
			"visible": true,
			"parentCellId": "770843b1-8e9f-43b1-aa30-15aa21b5fdf6"
		},
		"src/SFML/Window/DRM/InputImpl.cpp-simstep-1754f7ca-d3c3-42e5-977b-fbb1e2438985": {
			"path": "src/SFML/Window/DRM/InputImpl.cpp-simstep-1754f7ca-d3c3-42e5-977b-fbb1e2438985",
			"fileName": "InputImpl.cpp",
			"wiki": "The platform-specific implementation code interprets the raw OS event data (e.g., a key code, mouse coordinates) and constructs the corresponding `sf::Event` subtype, such as `sf::Event::KeyPressed` or `sf::Event::MouseMoved`.",
			"cellName": "Event Polling: Platform Translates OS Event to SFML Event - InputImpl.cpp:L376-382",
			"cellId": "33429860-81eb-45c6-ae04-b56c67b15f8f",
			"visible": true,
			"startLine": 376,
			"endLine": 382,
			"parentCellId": "770843b1-8e9f-43b1-aa30-15aa21b5fdf6",
			"parentPath": "src/SFML/Window/DRM/InputImpl.cpp"
		},
		"2933c66a-fad6-4cef-a5ba-d2a8d0c0aaf4": {
			"path": "2933c66a-fad6-4cef-a5ba-d2a8d0c0aaf4",
			"cellName": "Event Polling: Application Handles Specific Event - EventHandling.cpp:L131-134",
			"cellId": "2933c66a-fad6-4cef-a5ba-d2a8d0c0aaf4",
			"visible": true,
			"parentCellId": "ca99bf2f-dc2d-48ea-ad08-fc2e3df091ad"
		},
		"examples/event_handling/EventHandling.cpp-simstep-b2461801-db87-4f53-ad24-96e735a7f67b": {
			"path": "examples/event_handling/EventHandling.cpp-simstep-b2461801-db87-4f53-ad24-96e735a7f67b",
			"fileName": "EventHandling.cpp",
			"wiki": "The application receives the polled event. It then uses type-safe methods like `event->is<T>()` or `event->getIf<T>()` to identify the event type and access its specific data, executing the appropriate logic.",
			"cellName": "Event Polling: Application Handles Specific Event - EventHandling.cpp:L131-134",
			"cellId": "2933c66a-fad6-4cef-a5ba-d2a8d0c0aaf4",
			"visible": true,
			"startLine": 131,
			"endLine": 134,
			"parentCellId": "ca99bf2f-dc2d-48ea-ad08-fc2e3df091ad",
			"parentPath": "examples/event_handling/EventHandling.cpp"
		},
		"596e1f26-08c2-4d47-917a-8e98749348aa": {
			"path": "596e1f26-08c2-4d47-917a-8e98749348aa",
			"cellName": "Real-Time Query: Application Checks Key Press - Tennis.cpp:L163",
			"cellId": "596e1f26-08c2-4d47-917a-8e98749348aa",
			"visible": true,
			"parentCellId": "375d9713-4499-4c06-8630-3364d95ebb0e"
		},
		"examples/tennis/Tennis.cpp-simstep-6a57528f-f4b7-4c34-89fb-a9ee236ffdc9": {
			"path": "examples/tennis/Tennis.cpp-simstep-6a57528f-f4b7-4c34-89fb-a9ee236ffdc9",
			"fileName": "Tennis.cpp",
			"wiki": "For continuous input like character movement, the application directly queries the real-time state of a specific key by calling `sf::Keyboard::isKeyPressed()`. This check is typically performed every frame.",
			"cellName": "Real-Time Query: Application Checks Key Press - Tennis.cpp:L163",
			"cellId": "596e1f26-08c2-4d47-917a-8e98749348aa",
			"visible": true,
			"startLine": 163,
			"endLine": 163,
			"parentCellId": "375d9713-4499-4c06-8630-3364d95ebb0e",
			"parentPath": "examples/tennis/Tennis.cpp"
		},
		"c9128104-9970-4676-99e4-2457ec9db1d7": {
			"path": "c9128104-9970-4676-99e4-2457ec9db1d7",
			"cellName": "Real-Time Query: sf::Keyboard Forwards Call - Keyboard.cpp:L36-39",
			"cellId": "c9128104-9970-4676-99e4-2457ec9db1d7",
			"visible": true,
			"parentCellId": "4bc72a63-234a-4d1c-8e4a-d4ca9e1ae1a4"
		},
		"src/SFML/Window/Keyboard.cpp-simstep-2a4a152c-3d4e-4d78-a767-64190e681d3c": {
			"path": "src/SFML/Window/Keyboard.cpp-simstep-2a4a152c-3d4e-4d78-a767-64190e681d3c",
			"fileName": "Keyboard.cpp",
			"wiki": "The static `sf::Keyboard::isKeyPressed` function acts as a public API entry point and forwards the call to the internal, platform-agnostic `InputImpl` module.",
			"cellName": "Real-Time Query: sf::Keyboard Forwards Call - Keyboard.cpp:L36-39",
			"cellId": "c9128104-9970-4676-99e4-2457ec9db1d7",
			"visible": true,
			"startLine": 36,
			"endLine": 39,
			"parentCellId": "4bc72a63-234a-4d1c-8e4a-d4ca9e1ae1a4",
			"parentPath": "src/SFML/Window/Keyboard.cpp"
		},
		"bc33b19f-302c-43e9-ae39-fc636dee075e": {
			"path": "bc33b19f-302c-43e9-ae39-fc636dee075e",
			"cellName": "Real-Time Query: OS Queries Key State - InputImpl.cpp:L589-593",
			"cellId": "bc33b19f-302c-43e9-ae39-fc636dee075e",
			"visible": true,
			"parentCellId": "891b787c-928d-4908-96c7-93e2bca4df0e"
		},
		"src/SFML/Window/Win32/InputImpl.cpp-simstep-636043a1-0498-4913-b7e6-5863f7a0fc48": {
			"path": "src/SFML/Window/Win32/InputImpl.cpp-simstep-636043a1-0498-4913-b7e6-5863f7a0fc48",
			"fileName": "InputImpl.cpp",
			"wiki": "The platform-specific code calls a native OS function (like `GetAsyncKeyState` on Windows) to get the instantaneous state of the physical key, bypassing the event queue.",
			"cellName": "Real-Time Query: OS Queries Key State - InputImpl.cpp:L589-593",
			"cellId": "bc33b19f-302c-43e9-ae39-fc636dee075e",
			"visible": true,
			"startLine": 589,
			"endLine": 593,
			"parentCellId": "891b787c-928d-4908-96c7-93e2bca4df0e",
			"parentPath": "src/SFML/Window/Win32/InputImpl.cpp"
		},
		"24e54584-9e26-498d-b7e2-6e570b28a2fa": {
			"path": "24e54584-9e26-498d-b7e2-6e570b28a2fa",
			"cellName": "Real-Time Query: Application Uses Key State - Tennis.cpp:L165",
			"cellId": "24e54584-9e26-498d-b7e2-6e570b28a2fa",
			"visible": true,
			"parentCellId": "375d9713-4499-4c06-8630-3364d95ebb0e"
		},
		"examples/tennis/Tennis.cpp-simstep-bf2ed579-fb2b-4b49-9355-43b4f296595a": {
			"path": "examples/tennis/Tennis.cpp-simstep-bf2ed579-fb2b-4b49-9355-43b4f296595a",
			"fileName": "Tennis.cpp",
			"wiki": "The application receives the boolean result and uses it to execute continuous game logic, such as moving a paddle.",
			"cellName": "Real-Time Query: Application Uses Key State - Tennis.cpp:L165",
			"cellId": "24e54584-9e26-498d-b7e2-6e570b28a2fa",
