							"out"
						]
					},
					"inputDataExample": "{\"data_pointer\": \"0x...\", \"size\": 19}",
					"outputDataExample": "{\"status\": \"Done\"}"
				},
				{
					"simStepId": "05213b4d-d79d-4aa8-9f4c-ba1c1cafaafd",
					"diagramNodeId": "d73fd233-0ea6-4b87-8056-77a90050f971",
					"simStepLabel": "Server Flow: Awaiting Client Response",
					"simStepDescription": "After sending the initial message, the server waits for a reply from the client. The `receive` call will block until data arrives.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Network/TcpSocket.cpp",
						"startLine": "273",
						"endLine": "298",
						"relevantVariables": [
							"receive"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "be58280f-b063-41f7-a7b0-1e42dd43cf07",
					"diagramNodeId": "64a78aa7-6dad-45fd-a5d2-09bebc330032",
					"simStepLabel": "Server Flow: Receive Data from Client",
					"simStepDescription": "The server calls `receive()` on the socket, which blocks until it receives data from the client. The received bytes are stored in a buffer.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/sockets/TCP.cpp",
						"startLine": "40",
						"endLine": "41",
						"relevantVariables": [
							"socket.receive",
							"in",
							"received"
						]
					},
					"inputDataExample": "{\"buffer\": \"char array[1024]\", \"buffer_size\": 1024}",
					"outputDataExample": "{\"status\": \"Done\", \"bytes_received\": 17}"
				},
				{
					"simStepId": "bf7274e0-78df-4bb7-8fc3-66603b08ef30",
					"diagramNodeId": "922ad2c2-368c-4e57-9351-382b22cb3a8f",
					"simStepLabel": "Server Flow: Data Received",
					"simStepDescription": "Data sent by the client arrives over the network and is read from the socket into the server's buffer.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Network/TcpSocket.cpp",
						"startLine": "282",
						"endLine": "285",
						"relevantVariables": [
