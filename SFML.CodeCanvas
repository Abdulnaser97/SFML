		"ac890c2a-46ee-4bff-8ae9-948534ac824a": {
			"path": "ac890c2a-46ee-4bff-8ae9-948534ac824a",
			"cellName": "Server Flow: Create TCP Listener - TCP.cpp:L21",
			"cellId": "ac890c2a-46ee-4bff-8ae9-948534ac824a",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-f4403d51-dce3-45e8-a9c5-bb9f7565280f": {
			"path": "examples/sockets/TCP.cpp-simstep-f4403d51-dce3-45e8-a9c5-bb9f7565280f",
			"fileName": "TCP.cpp",
			"wiki": "The server application initializes an `sf::TcpListener` to prepare for accepting incoming client connections. This object will be used to listen on a specific network port.",
			"cellName": "Server Flow: Create TCP Listener - TCP.cpp:L21",
			"cellId": "ac890c2a-46ee-4bff-8ae9-948534ac824a",
			"visible": true,
			"startLine": 21,
			"endLine": 21,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"214ac8ff-8d59-4115-85c6-b1be00caff59": {
			"path": "214ac8ff-8d59-4115-85c6-b1be00caff59",
			"cellName": "Server Flow: Start Listening on a Port - TCP.cpp:L24-25",
			"cellId": "214ac8ff-8d59-4115-85c6-b1be00caff59",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-e733e34a-14af-4a9c-955a-b2e8dd030139": {
			"path": "examples/sockets/TCP.cpp-simstep-e733e34a-14af-4a9c-955a-b2e8dd030139",
			"fileName": "TCP.cpp",
			"wiki": "The server calls `listen()` on the `sf::TcpListener` instance, binding it to a specific port and putting it into a state where it can accept new connections.",
			"cellName": "Server Flow: Start Listening on a Port - TCP.cpp:L24-25",
			"cellId": "214ac8ff-8d59-4115-85c6-b1be00caff59",
			"visible": true,
			"startLine": 24,
			"endLine": 25,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"a60d99c1-e1fe-4894-b801-a85aa5faef8a": {
			"path": "a60d99c1-e1fe-4894-b801-a85aa5faef8a",
			"cellName": "Server Flow: Accept New Connection - TCP.cpp:L28-29",
			"cellId": "a60d99c1-e1fe-4894-b801-a85aa5faef8a",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-893b1d1c-a529-4082-b04c-677f5f787190": {
			"path": "examples/sockets/TCP.cpp-simstep-893b1d1c-a529-4082-b04c-677f5f787190",
			"fileName": "TCP.cpp",
			"wiki": "The server's main loop calls `accept()` on the listener. This is a blocking call that waits until a client connects, and then populates an `sf::TcpSocket` object to handle communication with that client.",
			"cellName": "Server Flow: Accept New Connection - TCP.cpp:L28-29",
			"cellId": "a60d99c1-e1fe-4894-b801-a85aa5faef8a",
			"visible": true,
			"startLine": 28,
			"endLine": 29,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"1962cefb-3982-4b48-a114-2f3054787def": {
			"path": "1962cefb-3982-4b48-a114-2f3054787def",
			"cellName": "Server Flow: Send Data to Client - TCP.cpp:L34-35",
			"cellId": "1962cefb-3982-4b48-a114-2f3054787def",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-c28c195d-c4b3-4497-bbaf-7feab7c7aea7": {
			"path": "examples/sockets/TCP.cpp-simstep-c28c195d-c4b3-4497-bbaf-7feab7c7aea7",
			"fileName": "TCP.cpp",
			"wiki": "The server sends a message to the client using `socket.send()`. This function takes a pointer to the data and its size, and attempts to send it through the underlying system socket.",
			"cellName": "Server Flow: Send Data to Client - TCP.cpp:L34-35",
			"cellId": "1962cefb-3982-4b48-a114-2f3054787def",
			"visible": true,
			"startLine": 34,
			"endLine": 35,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"64a78aa7-6dad-45fd-a5d2-09bebc330032": {
			"path": "64a78aa7-6dad-45fd-a5d2-09bebc330032",
			"cellName": "Server Flow: Receive Data from Client - TCP.cpp:L40-41",
			"cellId": "64a78aa7-6dad-45fd-a5d2-09bebc330032",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-be58280f-b063-41f7-a7b0-1e42dd43cf07": {
			"path": "examples/sockets/TCP.cpp-simstep-be58280f-b063-41f7-a7b0-1e42dd43cf07",
			"fileName": "TCP.cpp",
			"wiki": "The server calls `receive()` on the socket, which blocks until it receives data from the client. The received bytes are stored in a buffer.",
			"cellName": "Server Flow: Receive Data from Client - TCP.cpp:L40-41",
			"cellId": "64a78aa7-6dad-45fd-a5d2-09bebc330032",
			"visible": true,
			"startLine": 40,
			"endLine": 41,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"0dbd8a62-94b6-4cee-bdb4-e8565db0f717": {
			"path": "0dbd8a62-94b6-4cee-bdb4-e8565db0f717",
			"cellName": "Server Flow: Process Client Message - TCP.cpp:L42",
			"cellId": "0dbd8a62-94b6-4cee-bdb4-e8565db0f717",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-8f25504d-6782-43bf-ba8f-494984988d3a": {
			"path": "examples/sockets/TCP.cpp-simstep-8f25504d-6782-43bf-ba8f-494984988d3a",
			"fileName": "TCP.cpp",
			"wiki": "The server processes the received data, for example, by printing it to the console. The communication cycle for this client is complete, and the server can either continue communicating or close the socket.",
			"cellName": "Server Flow: Process Client Message - TCP.cpp:L42",
			"cellId": "0dbd8a62-94b6-4cee-bdb4-e8565db0f717",
			"visible": true,
			"startLine": 42,
			"endLine": 42,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"4e62f621-f96f-4050-904a-e345d70a366d": {
			"path": "4e62f621-f96f-4050-904a-e345d70a366d",
			"cellName": "Client Flow: Create TCP Socket - TCP.cpp:L68",
			"cellId": "4e62f621-f96f-4050-904a-e345d70a366d",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-6d2ee841-360e-4d21-a974-7b5e52300ad3": {
			"path": "examples/sockets/TCP.cpp-simstep-6d2ee841-360e-4d21-a974-7b5e52300ad3",
			"fileName": "TCP.cpp",
			"wiki": "The client application initializes an `sf::TcpSocket` object to communicate with a server.",
			"cellName": "Client Flow: Create TCP Socket - TCP.cpp:L68",
			"cellId": "4e62f621-f96f-4050-904a-e345d70a366d",
			"visible": true,
			"startLine": 68,
			"endLine": 68,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"24a7a25c-cf1d-4cb1-8bc8-bbcc3f7c7988": {
			"path": "24a7a25c-cf1d-4cb1-8bc8-bbcc3f7c7988",
			"cellName": "Client Flow: Connect to Server - TCP.cpp:L71-72",
			"cellId": "24a7a25c-cf1d-4cb1-8bc8-bbcc3f7c7988",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-cccd2f94-de9c-4360-b773-4d99291d4fc5": {
			"path": "examples/sockets/TCP.cpp-simstep-cccd2f94-de9c-4360-b773-4d99291d4fc5",
			"fileName": "TCP.cpp",
			"wiki": "The client calls `connect()` on the socket, providing the server's address and port. This initiates a TCP handshake to establish a connection with the listening server.",
			"cellName": "Client Flow: Connect to Server - TCP.cpp:L71-72",
			"cellId": "24a7a25c-cf1d-4cb1-8bc8-bbcc3f7c7988",
			"visible": true,
			"startLine": 71,
			"endLine": 72,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"ce2e96f9-64d6-4bab-b76b-88f14d92c368": {
			"path": "ce2e96f9-64d6-4bab-b76b-88f14d92c368",
			"cellName": "Client Flow: Receive Server Message - TCP.cpp:L78-79",
			"cellId": "ce2e96f9-64d6-4bab-b76b-88f14d92c368",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-e7f1cf34-84d8-442e-ba49-6d4e465a5d0f": {
			"path": "examples/sockets/TCP.cpp-simstep-e7f1cf34-84d8-442e-ba49-6d4e465a5d0f",
			"fileName": "TCP.cpp",
			"wiki": "The client calls `receive()` on the connected socket to wait for data from the server. This call blocks until the server sends its welcome message.",
			"cellName": "Client Flow: Receive Server Message - TCP.cpp:L78-79",
			"cellId": "ce2e96f9-64d6-4bab-b76b-88f14d92c368",
			"visible": true,
			"startLine": 78,
			"endLine": 79,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"7a9875e7-d3ad-49c3-9c4b-eb545a6fbec7": {
			"path": "7a9875e7-d3ad-49c3-9c4b-eb545a6fbec7",
			"cellName": "Client Flow: Send Response to Server - TCP.cpp:L84-85",
			"cellId": "7a9875e7-d3ad-49c3-9c4b-eb545a6fbec7",
			"visible": true,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c"
		},
		"examples/sockets/TCP.cpp-simstep-5b63769d-70b2-4e60-a7e6-3acbe3f5b055": {
			"path": "examples/sockets/TCP.cpp-simstep-5b63769d-70b2-4e60-a7e6-3acbe3f5b055",
			"fileName": "TCP.cpp",
			"wiki": "The client calls `send()` to transmit its response message to the server through the established TCP connection.",
			"cellName": "Client Flow: Send Response to Server - TCP.cpp:L84-85",
			"cellId": "7a9875e7-d3ad-49c3-9c4b-eb545a6fbec7",
			"visible": true,
			"startLine": 84,
			"endLine": 85,
			"parentCellId": "96eafc79-a1ac-4776-a673-10a6d5fc693c",
			"parentPath": "examples/sockets/TCP.cpp"
		},
		"6e16d197-6376-4dd3-b7d2-1bfc6498546d": {
			"path": "6e16d197-6376-4dd3-b7d2-1bfc6498546d",
			"cellName": "Client Flow: Disconnect - TcpSocket.hpp:L128-134",
			"cellId": "6e16d197-6376-4dd3-b7d2-1bfc6498546d",
			"visible": true,
			"parentCellId": "07afac77-b58e-45e9-bba5-dd81cd266b87"
		},
		"include/SFML/Network/TcpSocket.hpp-simstep-e777972b-e0f5-4fbe-8c81-5c4ad8ed2131": {
			"path": "include/SFML/Network/TcpSocket.hpp-simstep-e777972b-e0f5-4fbe-8c81-5c4ad8ed2131",
			"fileName": "TcpSocket.hpp",
			"wiki": "After the communication is complete, the client gracefully closes the connection by letting the socket's destructor handle it when it goes out of scope.",
			"cellName": "Client Flow: Disconnect - TcpSocket.hpp:L128-134",
			"cellId": "6e16d197-6376-4dd3-b7d2-1bfc6498546d",
			"visible": true,
			"startLine": 128,
			"endLine": 134,
			"parentCellId": "07afac77-b58e-45e9-bba5-dd81cd266b87",
			"parentPath": "include/SFML/Network/TcpSocket.hpp"
		},
		"1b0b0b70-48c1-4012-b37b-7e83c7c6249d": {
			"path": "1b0b0b70-48c1-4012-b37b-7e83c7c6249d",
			"cellName": "Data Serialization: Create Packet - Client.cpp:L72",
			"cellId": "1b0b0b70-48c1-4012-b37b-7e83c7c6249d",
			"visible": true,
			"parentCellId": "65a9c0c6-768d-4990-b998-bd10cff358e3"
		},
		"examples/voip/Client.cpp-simstep-2dc68e00-3a7e-4119-b340-2c3695a1648b": {
			"path": "examples/voip/Client.cpp-simstep-2dc68e00-3a7e-4119-b340-2c3695a1648b",
			"fileName": "Client.cpp",
			"wiki": "For more robust communication, SFML provides `sf::Packet`. An empty packet is created to be filled with various data types.",
			"cellName": "Data Serialization: Create Packet - Client.cpp:L72",
			"cellId": "1b0b0b70-48c1-4012-b37b-7e83c7c6249d",
			"visible": true,
			"startLine": 72,
			"endLine": 72,
			"parentCellId": "65a9c0c6-768d-4990-b998-bd10cff358e3",
			"parentPath": "examples/voip/Client.cpp"
		},
		"8e6f45c1-e94c-4339-aba9-07fdf5f9c9c3": {
			"path": "8e6f45c1-e94c-4339-aba9-07fdf5f9c9c3",
			"cellName": "Data Serialization: Serialize Data into Packet - Client.cpp:L73-74",
			"cellId": "8e6f45c1-e94c-4339-aba9-07fdf5f9c9c3",
			"visible": true,
			"parentCellId": "65a9c0c6-768d-4990-b998-bd10cff358e3"
		},
		"examples/voip/Client.cpp-simstep-8c56e041-2e15-4808-8cb4-485db1a79331": {
			"path": "examples/voip/Client.cpp-simstep-8c56e041-2e15-4808-8cb4-485db1a79331",
			"fileName": "Client.cpp",
			"wiki": "Using the overloaded `<<` operator, different data types are serialized into the packet's internal byte array. SFML handles byte order conversions to ensure cross-platform compatibility.",
			"cellName": "Data Serialization: Serialize Data into Packet - Client.cpp:L73-74",
			"cellId": "8e6f45c1-e94c-4339-aba9-07fdf5f9c9c3",
			"visible": true,
			"startLine": 73,
			"endLine": 74,
			"parentCellId": "65a9c0c6-768d-4990-b998-bd10cff358e3",
			"parentPath": "examples/voip/Client.cpp"
		},
		"5d13a864-6f8a-4e35-a110-041a2e4c0e23": {
			"path": "5d13a864-6f8a-4e35-a110-041a2e4c0e23",
			"cellName": "Data Serialization: Send Packet - TcpSocket.cpp:L309-358",
			"cellId": "5d13a864-6f8a-4e35-a110-041a2e4c0e23",
			"visible": true,
			"parentCellId": "04f53cc5-2c3f-474b-90e6-8f5b03ee1835"
		},
		"src/SFML/Network/TcpSocket.cpp-simstep-0bf13c4f-2f02-4f2c-8a88-507f2d1c37ea": {
			"path": "src/SFML/Network/TcpSocket.cpp-simstep-0bf13c4f-2f02-4f2c-8a88-507f2d1c37ea",
			"fileName": "TcpSocket.cpp",
			"wiki": "The `socket.send(packet)` method is called. This implementation first sends the total size of the packet data as a 32-bit integer, followed by the actual packet data. This ensures the receiver knows exactly how many bytes to read for one complete packet.",
			"cellName": "Data Serialization: Send Packet - TcpSocket.cpp:L309-358",
			"cellId": "5d13a864-6f8a-4e35-a110-041a2e4c0e23",
			"visible": true,
			"startLine": 309,
			"endLine": 358,
			"parentCellId": "04f53cc5-2c3f-474b-90e6-8f5b03ee1835",
			"parentPath": "src/SFML/Network/TcpSocket.cpp"
		},
