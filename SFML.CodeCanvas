	"simulations": {
		"Create and manage an application window": {
			"name": "Create and manage an application window",
			"simSteps": [
				{
					"simStepId": "72dfabb8-9fa7-4a1a-9c8b-bce364ea80c6",
					"diagramNodeId": "eaa6c395-9c69-47a7-81f2-3c3c3fa1a306",
					"simStepLabel": "Application Creates Window",
					"simStepDescription": "The application's `main` function initializes and creates a window object. This example uses `sf::Window`, but `sf::RenderWindow` is also common. It specifies the window's dimensions, title, style, and context settings.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/window/Window.cpp",
						"startLine": "32",
						"endLine": "34",
						"relevantVariables": [
							"window",
							"sf::Window",
							"sf::VideoMode",
							"sf::ContextSettings"
						]
					},
					"inputDataExample": "{\"argc\": 1, \"argv\": [\"my_program.exe\"]}",
					"outputDataExample": "{\"mode\": {\"size\": {\"x\": 640, \"y\": 480}, \"bitsPerPixel\": 32}, \"title\": \"SFML window with OpenGL\", \"style\": \"sf::Style::Default\", \"state\": \"sf::State::Windowed\", \"settings\": {\"depthBits\": 24}}"
				},
				{
					"simStepId": "0fbf785d-67dd-41cc-ad1a-ba907dc79764",
					"diagramNodeId": "1d22e6c2-6218-4cd7-849f-7e1268bed1e3",
					"simStepLabel": "Window Configuration Passed to Constructor",
					"simStepDescription": "The configuration parameters (video mode, title, style, state, and context settings) are passed to the `sf::Window` constructor to begin the window creation process.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Window/Window.hpp",
						"startLine": "84",
						"endLine": "89",
						"relevantVariables": [
							"Window::Window",
							"mode",
							"title",
							"style",
							"state",
							"settings"
						]
					},
					"inputDataExample": "{\"mode\": {\"size\": {\"x\": 640, \"y\": 480}, \"bitsPerPixel\": 32}, \"title\": \"SFML window with OpenGL\", \"style\": \"sf::Style::Default\", \"state\": \"sf::State::Windowed\", \"settings\": {\"depthBits\": 24}}",
					"outputDataExample": "{\"mode\": {\"size\": {\"x\": 640, \"y\": 480}, \"bitsPerPixel\": 32}, \"title\": \"SFML window with OpenGL\", \"style\": \"sf::Style::Default\", \"state\": \"sf::State::Windowed\", \"settings\": {\"depthBits\": 24}}"
				},
				{
					"simStepId": "4178e2dd-ca7f-4258-a28a-0678d6f89c27",
					"diagramNodeId": "25ac6a69-0f14-4708-b107-0c112ea57204",
					"simStepLabel": "Window Constructor Invokes `create`",
					"simStepDescription": "The `sf::Window` constructor delegates the actual creation logic to its virtual `create` method. This method, in turn, calls the platform-agnostic `sf::WindowBase` to handle the creation of the underlying OS-specific window implementation.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Window/Window.hpp",
						"startLine": "165",
						"endLine": "165",
						"relevantVariables": [
							"Window::create"
						]
					},
					"inputDataExample": "{\"mode\": {\"size\": {\"x\": 640, \"y\": 480}, \"bitsPerPixel\": 32}, \"title\": \"SFML window with OpenGL\", \"style\": \"sf::Style::Default\", \"state\": \"sf::State::Windowed\", \"settings\": {\"depthBits\": 24}}",
					"outputDataExample": "{\"handle\": \"(platform-specific handle)\"}"
				},
				{
					"simStepId": "77b822d6-e5be-4a60-8e58-1c68e41698ec",
					"diagramNodeId": "cac29bd8-99c5-499a-a8ea-a5f8ad3b4322",
					"simStepLabel": "Request for Platform-Specific Implementation",
					"simStepDescription": "The `sf::Window`'s `create` method calls a static factory function `priv::WindowImpl::create` to instantiate the appropriate platform-specific window implementation (e.g., `WindowImplWin32` on Windows, `WindowImplX11` on Linux).",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowImpl.hpp",
						"startLine": "74",
						"endLine": "81",
						"relevantVariables": [
							"WindowImpl::create"
						]
					},
					"inputDataExample": "{\"mode\": {\"size\": {\"x\": 640, \"y\": 480}}, \"title\": \"SFML window...\", \"style\": 7, \"state\": 0, \"settings\": {\"depthBits\": 24, ...}}",
					"outputDataExample": "{\"mode\": {\"size\": {\"x\": 640, \"y\": 480}}, \"title\": \"SFML window...\", \"style\": 7, \"state\": 0, \"settings\": {\"depthBits\": 24, ...}}"
				},
				{
					"simStepId": "e0154805-096e-4b0a-8e83-022e2e9d20da",
					"diagramNodeId": "55956850-c89c-44e9-a723-4c5eb5bc9e78",
					"simStepLabel": "Native OS Window Creation",
					"simStepDescription": "The platform-specific `WindowImpl` class uses native OS APIs (e.g., Win32 API, X11, Cocoa) to create the actual window and its associated graphics context. Once created, it holds a native handle to this window.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowImpl.hpp",
						"startLine": "157",
						"endLine": "157",
						"relevantVariables": [
							"getNativeHandle"
						]
					},
					"inputDataExample": "{\"mode\": {\"size\": {\"x\": 640, \"y\": 480}}, \"title\": \"SFML window...\", \"style\": 7, \"state\": 0, \"settings\": {\"depthBits\": 24, ...}}",
					"outputDataExample": "{\"nativeHandle\": \"0x1A2B3C4D\"}"
				},
				{
					"simStepId": "b9038866-1b24-4856-a21f-d091eaaeef6d",
					"diagramNodeId": "ed5a0b41-e3bc-408f-a6f9-a6287910345c",
					"simStepLabel": "Window Handle Returned",
					"simStepDescription": "The native window handle is returned from the platform-specific implementation and stored within the `sf::WindowBase` object, which now represents a fully realized window.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Window/WindowBase.hpp",
						"startLine": "545",
						"endLine": "546",
						"relevantVariables": [
							"getNativeHandle"
						]
					},
					"inputDataExample": "{\"nativeHandle\": \"0x1A2B3C4D\"}",
					"outputDataExample": "{\"nativeHandle\": \"0x1A2B3C4D\"}"
				},
				{
					"simStepId": "eada8035-fca7-4aa1-9525-f98f9a658618",
					"diagramNodeId": "b40e18a5-1478-41fc-91ce-d4b416872b7d",
					"simStepLabel": "Enter Main Application Loop",
					"simStepDescription": "With the window successfully created, the application enters its main loop. The loop's continuation is controlled by the `window.isOpen()` method.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/window/Window.cpp",
						"startLine": "142",
						"endLine": "142",
						"relevantVariables": [
							"window.isOpen"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"isWindowOpen\": true}"
				},
				{
					"simStepId": "4731e5ab-5d90-4863-a7e1-b6718de2efc1",
					"diagramNodeId": "fdd15c3b-e667-4cdc-a7bc-a75c9517b3f6",
					"simStepLabel": "Check if Window is Open",
					"simStepDescription": "The `isOpen()` method is called at the beginning of each loop iteration. It checks if the underlying platform-specific implementation (`m_impl`) is valid (i.e., not null).",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowBase.cpp",
						"startLine": "132",
						"endLine": "135",
						"relevantVariables": [
							"isOpen",
							"m_impl"
						]
					},
					"inputDataExample": "{\"isWindowOpen\": true}",
					"outputDataExample": "{\"isWindowOpen\": true}"
				},
				{
					"simStepId": "4dc20f3e-e6c5-427d-8cf5-ec6de723cac6",
					"diagramNodeId": "54326259-f66c-42d4-8703-b21c0fab1d3e",
					"simStepLabel": "Poll for Window Events",
					"simStepDescription": "Inside the main loop, the application calls `window.pollEvent()` to retrieve events from the window's event queue, such as user input or window state changes.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/window/Window.cpp",
						"startLine": "145",
						"endLine": "145",
						"relevantVariables": [
							"window.pollEvent",
							"event"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"event\": {\"type\": \"Closed\"}}"
				},
				{
					"simStepId": "e9bc40f0-c2d8-4c8e-9704-b71f1edac419",
					"diagramNodeId": "e19b3ae6-eede-412a-9636-7ff03ba8e5fa",
					"simStepLabel": "Forward `pollEvent` to Implementation",
					"simStepDescription": "The `sf::WindowBase::pollEvent()` call is forwarded to the underlying platform-specific implementation, `m_impl->pollEvent()`, which handles communication with the operating system.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowBase.cpp",
						"startLine": "146",
						"endLine": "146",
						"relevantVariables": [
							"m_impl->pollEvent",
							"event"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"event\": {\"type\": \"Closed\"}}"
				},
				{
					"simStepId": "fb87c0fa-9648-4b9f-b633-115a36ae36c6",
					"diagramNodeId": "c1848dd0-ddee-4eff-8c75-62b4e11a18cc",
					"simStepLabel": "OS Event Processing",
					"simStepDescription": "The `WindowImpl`'s `pollEvent` method calls `populateEventQueue`. This function queries the operating system for pending messages, translates them from their native format into `sf::Event` objects, and pushes them onto an internal event queue.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowImpl.cpp",
						"startLine": "254",
						"endLine": "254",
						"relevantVariables": [
							"populateEventQueue",
							"m_events"
						]
					},
					"inputDataExample": "{\"os_message\": \"WM_CLOSE\"}",
					"outputDataExample": "{\"internal_event_queue\": [{\"type\": \"Closed\"}]}"
				},
				{
					"simStepId": "9ddab230-4381-473c-8fff-dc7fecd34460",
					"diagramNodeId": "b829e620-216e-4b68-a749-3f1175682aa8",
					"simStepLabel": "`sf::Event` Returned to Application",
					"simStepDescription": "After populating the queue, `WindowImpl::pollEvent` returns the next event by calling `popEvent`. This event, wrapped in a `std::optional`, travels back up the call stack to the user's application code.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowImpl.cpp",
						"startLine": "262",
						"endLine": "271",
						"relevantVariables": [
							"popEvent",
							"m_events"
						]
					},
					"inputDataExample": "{\"event\": {\"type\": \"Closed\"}}",
					"outputDataExample": "{\"event\": {\"type\": \"Closed\"}}"
				},
				{
					"simStepId": "7f62ffee-a4ae-4578-bf0d-1dfed26906fd",
					"diagramNodeId": "123cd87b-b4fa-4f50-91e5-df6edb3642d0",
					"simStepLabel": "Application Handles `Closed` Event",
					"simStepDescription": "The application code inspects the event. Upon receiving an `sf::Event::Closed` event (typically triggered by the user clicking the window's close button), it calls `window.close()` to initiate the window shutdown process.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/window/Window.cpp",
						"startLine": "148",
						"endLine": "151",
						"relevantVariables": [
							"event",
							"sf::Event::Closed",
							"window.close"
						]
					},
					"inputDataExample": "{\"event\": {\"type\": \"Closed\"}}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "2d874fb9-5877-4505-ad85-70e6e079282f",
					"diagramNodeId": "c1b75735-e732-402e-b24a-cdf3ff5a1faf",
					"simStepLabel": "Window Close Request",
					"simStepDescription": "The `window.close()` method is called by the application. This is a request to terminate the window and release its resources.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Window/WindowBase.hpp",
						"startLine": "192",
						"endLine": "192",
						"relevantVariables": [
							"close"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "5fca8efd-ec9f-442c-8e42-5061bfde1335",
					"diagramNodeId": "37117a88-45ef-4586-b07a-5707a216b6d2",
					"simStepLabel": "Window Implementation Destroyed",
					"simStepDescription": "The `sf::WindowBase::close()` method resets the `std::unique_ptr` holding the platform-specific implementation (`m_impl`). This triggers the destructor of the `WindowImpl` subclass, which calls the necessary OS APIs to destroy the native window.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowBase.cpp",
						"startLine": "128",
						"endLine": "129",
						"relevantVariables": [
							"close",
							"m_impl.reset"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"m_impl\": null}"
				},
				{
					"simStepId": "44123a7b-2a0e-4b05-b1f2-57e4d90c36cc",
					"diagramNodeId": "66ff124d-01e0-49e5-a99f-3f9b80db2a19",
					"simStepLabel": "Loop Condition Check Fails",
					"simStepDescription": "The main loop condition `window.isOpen()` is checked again. Since `m_impl` was reset to `nullptr` in the previous step, `isOpen()` now returns `false`, causing the loop to terminate.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Window/WindowBase.cpp",
						"startLine": "132",
						"endLine": "135",
						"relevantVariables": [
							"isOpen",
							"m_impl"
						]
					},
					"inputDataExample": "{\"isWindowOpen\": false}",
					"outputDataExample": "{\"isWindowOpen\": false}"
				},
				{
					"simStepId": "cbf54c1d-1d98-4699-aab2-4e9b14c4e30a",
					"diagramNodeId": "b6e5c505-8299-4c02-a548-2061d6e389be",
					"simStepLabel": "Application Termination",
					"simStepDescription": "After the main loop exits, the `sf::Window` object's destructor is called as it goes out of scope. The `main` function then returns, and the application terminates.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/window/Window.cpp",
						"startLine": "185",
						"endLine": "185",
						"relevantVariables": [
							"EXIT_SUCCESS"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"exitCode\": 0}"
				}
			],
			"description": "<ul><li>This is the most fundamental use case of SFML, providing the canvas for all visual output and the source for user input</li><li>- Open a native OS window with specified dimensions, title, and style (e</li><li>g</li><li>, resizable, fullscreen)</li><li>- Run the main application loop, which typically continues as long as the window is open (<code>window</li><li>isOpen()</code>)</li><li>- Process window-related events such as closing, resizing, or focus changes</li><li>- Control window properties like vertical sync (<code>setVerticalSyncEnabled</code>) and frame rate (<code>setFramerateLimit</code>)</li></ul>",
			"simulationNodesAndEdges": {
