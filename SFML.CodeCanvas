					},
					"inputDataExample": "{\"server_ip\": \"127.0.0.1\", \"port\": 55001}",
					"outputDataExample": "{\"server_ip\": \"127.0.0.1\", \"port\": 55001}"
				},
				{
					"simStepId": "cccd2f94-de9c-4360-b773-4d99291d4fc5",
					"diagramNodeId": "24a7a25c-cf1d-4cb1-8bc8-bbcc3f7c7988",
					"simStepLabel": "Client Flow: Connect to Server",
					"simStepDescription": "The client calls `connect()` on the socket, providing the server's address and port. This initiates a TCP handshake to establish a connection with the listening server.",
					"isEdge": 0,
