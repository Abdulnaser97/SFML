		},
		"628af0bb-2c3b-46d5-af54-22e9d6f3d454": {
			"path": "628af0bb-2c3b-46d5-af54-22e9d6f3d454",
			"cellName": "RenderTarget.cpp",
			"cellId": "628af0bb-2c3b-46d5-af54-22e9d6f3d454",
			"visible": true,
			"parentCellId": "a71605b6-99d0-4aed-b514-f2343c57386f"
		},
		"a997b7ec-af93-4e0e-87bc-73a6d1cc67b3": {
			"path": "a997b7ec-af93-4e0e-87bc-73a6d1cc67b3",
			"cellName": "RenderTexture.hpp",
			"cellId": "a997b7ec-af93-4e0e-87bc-73a6d1cc67b3",
			"visible": true,
			"parentCellId": "5cd1a142-9555-4c25-b56f-b766738ee3de"
		},
		"1fa55cb6-f31f-4675-9a6e-fc7b21c6e310": {
			"path": "1fa55cb6-f31f-4675-9a6e-fc7b21c6e310",
			"cellName": "Initialize Off-Screen Render Target - Shader.cpp:L311-315",
			"cellId": "1fa55cb6-f31f-4675-9a6e-fc7b21c6e310",
			"visible": true,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1"
		},
		"examples/shader/Shader.cpp-simstep-39b7d5e1-693d-4583-a666-8bec43049df3": {
			"path": "examples/shader/Shader.cpp-simstep-39b7d5e1-693d-4583-a666-8bec43049df3",
			"fileName": "Shader.cpp",
			"wiki": "An `sf::RenderTexture` is created to serve as an off-screen buffer. It is initialized with a specific size and properties like smoothing. This object acts as a drawing target, similar to a window, but its output is stored in a texture.",
			"cellName": "Initialize Off-Screen Render Target - Shader.cpp:L311-315",
			"cellId": "1fa55cb6-f31f-4675-9a6e-fc7b21c6e310",
			"visible": true,
			"startLine": 311,
			"endLine": 315,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1",
			"parentPath": "examples/shader/Shader.cpp"
		},
		"76ab54d1-d312-4bb2-941d-adf1a51f152c": {
			"path": "76ab54d1-d312-4bb2-941d-adf1a51f152c",
			"cellName": "Render Scene to Off-Screen Texture - Shader.cpp:L174-192",
			"cellId": "76ab54d1-d312-4bb2-941d-adf1a51f152c",
			"visible": true,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1"
		},
		"examples/shader/Shader.cpp-simstep-61cad681-ad9e-4d87-a6e8-48970ebf4a44": {
			"path": "examples/shader/Shader.cpp-simstep-61cad681-ad9e-4d87-a6e8-48970ebf4a44",
			"fileName": "Shader.cpp",
			"wiki": "Within the `Edge::update` method, the `sf::RenderTexture` is first cleared. Then, various drawable objects, such as background and entity sprites, are drawn onto it. These drawing operations render into the texture's memory, not directly to the screen.",
			"cellName": "Render Scene to Off-Screen Texture - Shader.cpp:L174-192",
			"cellId": "76ab54d1-d312-4bb2-941d-adf1a51f152c",
			"visible": true,
			"startLine": 174,
			"endLine": 192,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1",
			"parentPath": "examples/shader/Shader.cpp"
		},
		"9b783e7a-3fc9-4d66-8653-94faa440c341": {
			"path": "9b783e7a-3fc9-4d66-8653-94faa440c341",
			"cellName": "Finalize Off-Screen Texture Content - Shader.cpp:L194",
			"cellId": "9b783e7a-3fc9-4d66-8653-94faa440c341",
			"visible": true,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1"
		},
		"examples/shader/Shader.cpp-simstep-ca548921-31c6-450f-8b2f-78325a27232f": {
			"path": "examples/shader/Shader.cpp-simstep-ca548921-31c6-450f-8b2f-78325a27232f",
			"fileName": "Shader.cpp",
			"wiki": "The `display()` method is called on the `sf::RenderTexture`. This finalizes the drawing operations performed on it, updating the internal texture with the rendered content and making it available for subsequent use.",
			"cellName": "Finalize Off-Screen Texture Content - Shader.cpp:L194",
			"cellId": "9b783e7a-3fc9-4d66-8653-94faa440c341",
			"visible": true,
			"startLine": 194,
			"endLine": 194,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1",
			"parentPath": "examples/shader/Shader.cpp"
		},
		"3aa6d527-8cf4-4117-9f93-83db7a6e8f2a": {
			"path": "3aa6d527-8cf4-4117-9f93-83db7a6e8f2a",
			"cellName": "Retrieve Texture for Post-Processing - RenderTexture.hpp:L253-264",
			"cellId": "3aa6d527-8cf4-4117-9f93-83db7a6e8f2a",
			"visible": true,
			"parentCellId": "a997b7ec-af93-4e0e-87bc-73a6d1cc67b3"
		},
		"include/SFML/Graphics/RenderTexture.hpp-simstep-495cbc79-5a19-4587-842a-8acdf3c63242": {
			"path": "include/SFML/Graphics/RenderTexture.hpp-simstep-495cbc79-5a19-4587-842a-8acdf3c63242",
			"fileName": "RenderTexture.hpp",
			"wiki": "The `getTexture()` method is called on the `sf::RenderTexture` to obtain a constant reference to its internal, up-to-date texture. This texture is then used to construct a `sf::Sprite` for rendering to the main window.",
			"cellName": "Retrieve Texture for Post-Processing - RenderTexture.hpp:L253-264",
			"cellId": "3aa6d527-8cf4-4117-9f93-83db7a6e8f2a",
			"visible": true,
			"startLine": 253,
			"endLine": 264,
			"parentCellId": "a997b7ec-af93-4e0e-87bc-73a6d1cc67b3",
			"parentPath": "include/SFML/Graphics/RenderTexture.hpp"
		},
		"251f4d40-b6aa-4542-b5e3-ce7444271f27": {
			"path": "251f4d40-b6aa-4542-b5e3-ce7444271f27",
			"cellName": "Draw to Main Window with Post-Processing Shader - Shader.cpp:L198-201",
			"cellId": "251f4d40-b6aa-4542-b5e3-ce7444271f27",
			"visible": true,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1"
		},
		"examples/shader/Shader.cpp-simstep-8b1e1da3-64fd-49fc-842b-e7c955b29489": {
			"path": "examples/shader/Shader.cpp-simstep-8b1e1da3-64fd-49fc-842b-e7c955b29489",
			"fileName": "Shader.cpp",
			"wiki": "The main `sf::RenderWindow`'s `draw` method is called. It is passed the sprite containing the off-screen texture and render states that specify the post-processing shader. The SFML rendering pipeline draws this sprite to the window's back buffer, applying the fragment shader to every pixel of the texture.",
			"cellName": "Draw to Main Window with Post-Processing Shader - Shader.cpp:L198-201",
			"cellId": "251f4d40-b6aa-4542-b5e3-ce7444271f27",
			"visible": true,
			"startLine": 198,
			"endLine": 201,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1",
			"parentPath": "examples/shader/Shader.cpp"
		},
		"03f05d13-da4b-4f30-baf3-e9a8dac2ef90": {
			"path": "03f05d13-da4b-4f30-baf3-e9a8dac2ef90",
			"cellName": "Display Final Image on Screen - Shader.cpp:L517",
			"cellId": "03f05d13-da4b-4f30-baf3-e9a8dac2ef90",
			"visible": true,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1"
		},
		"examples/shader/Shader.cpp-simstep-4c311c59-24ba-478c-af81-5c73902ba570": {
			"path": "examples/shader/Shader.cpp-simstep-4c311c59-24ba-478c-af81-5c73902ba570",
			"fileName": "Shader.cpp",
			"wiki": "The `display()` method of the `sf::RenderWindow` is called. This swaps the back buffer (which contains the post-processed image) with the front buffer, making the final frame visible to the user.",
			"cellName": "Display Final Image on Screen - Shader.cpp:L517",
			"cellId": "03f05d13-da4b-4f30-baf3-e9a8dac2ef90",
			"visible": true,
			"startLine": 517,
			"endLine": 517,
			"parentCellId": "7b810f43-1fd2-4266-8010-c366e141b6a1",
			"parentPath": "examples/shader/Shader.cpp"
		},
		"aa5ea8af-dd5a-4f12-ae83-fe97065392b4": {
			"path": "aa5ea8af-dd5a-4f12-ae83-fe97065392b4",
			"cellName": "RenderTexture Ready\nfor Drawing",
			"cellId": "aa5ea8af-dd5a-4f12-ae83-fe97065392b4",
			"visible": true,
