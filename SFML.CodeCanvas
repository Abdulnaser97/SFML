		"Manage time for animations and game logic": {
			"name": "Manage time for animations and game logic",
			"simSteps": [
				{
					"simStepId": "c2a13a4d-fcc2-47b1-a6e5-d69871065c7f",
					"diagramNodeId": "af092811-2a7e-4734-8443-558b4f16495f",
					"simStepLabel": "Initialize Clock",
					"simStepDescription": "A `sf::Clock` instance is created before the main game loop begins. This object starts measuring time from the moment of its creation.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/tennis/Tennis.cpp",
