						]
					},
					"inputDataExample": "{\"message\": \"Hi, I'm a client\"}",
					"outputDataExample": "{\"message\": \"Hi, I'm a client\"}"
				},
				{
					"simStepId": "8f25504d-6782-43bf-ba8f-494984988d3a",
					"diagramNodeId": "0dbd8a62-94b6-4cee-bdb4-e8565db0f717",
					"simStepLabel": "Server Flow: Process Client Message",
					"simStepDescription": "The server processes the received data, for example, by printing it to the console. The communication cycle for this client is complete, and the server can either continue communicating or close the socket.",
					"isEdge": 0,
					"sourceCodeMapping": {
