		"Play audio sounds and stream music": {
			"name": "Play audio sounds and stream music",
			"simSteps": [
				{
					"simStepId": "dea62be1-5e72-45c3-b097-8c7140a16ebe",
					"diagramNodeId": "49dfa503-b3b5-4649-a226-4c63fc77acbb",
					"simStepLabel": "Sound Flow: Load Audio File into SoundBuffer",
					"simStepDescription": "An audio file is loaded from disk into a `sf::SoundBuffer`. This involves opening the file, decoding its format (e.g., WAV, FLAC, OGG) using an appropriate `SoundFileReader`, and storing the entire set of raw audio samples in memory.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Audio/SoundBuffer.hpp",
						"startLine": "84",
						"endLine": "93",
						"relevantVariables": [
							"SoundBuffer(const std::filesystem::path& filename)"
						]
					},
					"inputDataExample": "{\"filename\": \"resources/killdeer.wav\"}",
					"outputDataExample": "{\"sampleCount\": 87798, \"sampleRate\": 44100, \"channelCount\": 1, \"duration\": \"1.99s\"}"
				},
				{
					"simStepId": "ad0e4ac0-5a72-430e-9b5e-8f414884b56b",
					"diagramNodeId": "59572d93-14bd-4f6e-88ae-77e213cc6965",
					"simStepLabel": "Sound Flow: Transmit Buffer to Sound Object",
					"simStepDescription": "The fully loaded `sf::SoundBuffer` instance, which contains all the audio samples in memory, is passed by reference to create an `sf::Sound` object. The `sf::Sound` object does not copy the data but maintains a reference to it.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "examples/sound/Sound.cpp",
						"startLine": "26",
						"endLine": "26",
						"relevantVariables": [
							"buffer",
							"sound"
						]
					},
					"inputDataExample": "{\"soundBufferReference\": \"@0x7ffc1...\"}",
					"outputDataExample": "{\"soundBufferReference\": \"@0x7ffc1...\"}"
				},
				{
					"simStepId": "749b926d-aba7-4e40-a92a-b86bdfb8b7e1",
					"diagramNodeId": "35bfb4ce-7c18-430a-a2d2-8bf1ee729fa2",
					"simStepLabel": "Sound Flow: Initialize Sound Object",
					"simStepDescription": "`sf::Sound` is initialized with the provided `sf::SoundBuffer`. It sets itself up as a playable sound source, connecting to the underlying audio backend (miniaudio) and preparing for playback without actually starting.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Audio/Sound.hpp",
						"startLine": "54",
						"endLine": "57",
						"relevantVariables": [
							"Sound(const SoundBuffer& buffer)"
						]
					},
					"inputDataExample": "{\"buffer\": {\"sampleCount\": 87798, \"sampleRate\": 44100}}",
					"outputDataExample": "{\"soundStatus\": \"Stopped\", \"isBufferAttached\": true}"
				},
				{
					"simStepId": "901f7846-1317-4de1-b4a1-15ce3b7695f9",
					"diagramNodeId": "3b657019-d111-4eda-8083-3bcec130ceb7",
					"simStepLabel": "Sound Flow: Send Play Command",
					"simStepDescription": "A `play` command is issued to the `sf::Sound` instance. This action signals the audio engine to start the playback process.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "examples/sound/Sound.cpp",
						"startLine": "27",
						"endLine": "27",
						"relevantVariables": [
							"sound.play()"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "23421b72-366a-4411-ac00-294c0f8b9fb4",
					"diagramNodeId": "45d9d0a9-9d03-4a07-a935-2e42c6844e55",
					"simStepLabel": "Sound Flow: Execute Sound Playback",
					"simStepDescription": "The `play()` method in `sf::Sound` triggers the audio backend (`miniaudio`) to start playing the sound. The backend reads the audio samples from the referenced `sf::SoundBuffer` and sends them to the active audio playback device.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Audio/Sound.cpp",
						"startLine": "218",
						"endLine": "233",
						"relevantVariables": [
							"Sound::play()",
							"ma_sound_start()",
							"m_impl->status"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"soundStatus\": \"Playing\"}"
				},
				{
					"simStepId": "b424dfeb-4e45-4759-941d-4711a9cc0667",
					"diagramNodeId": "ded08383-032b-4f02-8082-1839c3c92f6e",
					"simStepLabel": "Music Flow: Open Music File for Streaming",
					"simStepDescription": "A `sf::Music` object is created with a path to a long audio file. Unlike `sf::SoundBuffer`, this does not load the entire file into memory. Instead, it opens the file, reads its header to get format information (duration, sample rate, channels), and prepares for on-the-fly streaming.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Audio/Music.hpp",
						"startLine": "87",
						"endLine": "91",
						"relevantVariables": [
							"Music(const std::filesystem::path& filename)"
						]
					},
					"inputDataExample": "{\"filename\": \"resources/doodle_pop.ogg\"}",
					"outputDataExample": "{\"musicStatus\": \"Stopped\", \"duration\": \"24.002s\", \"sampleRate\": 44100, \"channelCount\": 2}"
				},
				{
					"simStepId": "a6fc19d8-7445-4179-8206-2c6306f73ffc",
					"diagramNodeId": "42f3fb35-4064-477a-bdd7-5b0bb00e7c90",
					"simStepLabel": "Music Flow: Send Play Command",
					"simStepDescription": "A `play` command is issued to the `sf::Music` instance. This signals the audio engine to begin the streaming and playback process.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "examples/sound/Sound.cpp",
						"startLine": "62",
						"endLine": "62",
						"relevantVariables": [
							"music.play()"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "774bc186-4156-486d-84c8-71277f22ecd7",
					"diagramNodeId": "830deb71-319b-4de5-8c37-39775d009a81",
					"simStepLabel": "Music Flow: Start Streaming Thread",
					"simStepDescription": "`sf::Music` inherits from `sf::SoundStream`. Its `play()` method initializes and starts the underlying audio backend, which operates in a separate thread. This thread is responsible for continuously requesting and playing chunks of audio data without blocking the main application.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Audio/SoundStream.cpp",
						"startLine": "274",
						"endLine": "289",
						"relevantVariables": [
							"SoundStream::play()",
							"ma_sound_start()",
							"m_impl->status"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"musicStatus\": \"Playing\"}"
				},
				{
					"simStepId": "5bc2b6e6-166c-47f2-823f-85806a557a18",
					"diagramNodeId": "454e29ca-d494-43d7-b568-958f85a45075",
					"simStepLabel": "Music Flow: Audio Backend Requests Data Chunk",
					"simStepDescription": "The audio backend, running in its thread, consumes audio samples and periodically requires more data to continue playing smoothly. It triggers a callback to the `sf::SoundStream` to request a new chunk of samples.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "include/SFML/Audio/SoundStream.hpp",
						"startLine": "250",
						"endLine": "260",
						"relevantVariables": [
							"onGetData(Chunk& data)"
						]
					},
					"inputDataExample": "{\"request\": \"need_more_samples\"}",
					"outputDataExample": "{\"request\": \"need_more_samples\"}"
				},
				{
					"simStepId": "099a910b-24af-46ce-bb72-883088d22a6b",
					"diagramNodeId": "233e59c3-7be1-41e3-a6f2-5a96b8f559dd",
					"simStepLabel": "Music Flow: Provide Audio Data Chunk",
					"simStepDescription": "The `sf::Music` class's implementation of `onGetData` is called. It reads a small chunk of audio data from the file on disk, fills the provided `Chunk` structure with the new samples, and returns `true` to the backend, indicating that the stream is ongoing. This process repeats until the file ends or is stopped.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Audio/Music.cpp",
						"startLine": "255",
						"endLine": "277",
						"relevantVariables": [
							"Music::onGetData(SoundStream::Chunk& data)",
							"m_impl->file.read()",
							"data.samples",
							"data.sampleCount"
						]
					},
					"inputDataExample": "{\"data\": {\"samples\": null, \"sampleCount\": 0}}",
					"outputDataExample": "{\"data\": {\"samples\": \"[...raw audio samples...]\", \"sampleCount\": 4096}}"
				}
			],
			"description": "<ul><li>SFML's audio module allows for easy integration of sound effects and background music</li><li>- Load short audio files (like WAV, Ogg/Vorbis, FLAC) into memory using <code>sf::SoundBuffer</code> and play them as sound effects via <code>sf::Sound</code></li><li>- Stream longer audio tracks directly from a file using <code>sf::Music</code> to conserve memory, which is ideal for background music</li><li>- Control audio playback with functions to play, pause, stop, set the volume, pitch, and looping properties</li></ul>",
			"simulationNodesAndEdges": {
				"49dfa503-b3b5-4649-a226-4c63fc77acbb": {
					"simStepIds": [
						"dea62be1-5e72-45c3-b097-8c7140a16ebe"
					]
				},
				"35bfb4ce-7c18-430a-a2d2-8bf1ee729fa2": {
					"simStepIds": [
						"749b926d-aba7-4e40-a92a-b86bdfb8b7e1"
					]
				},
				"45d9d0a9-9d03-4a07-a935-2e42c6844e55": {
					"simStepIds": [
						"23421b72-366a-4411-ac00-294c0f8b9fb4"
					]
				},
				"ded08383-032b-4f02-8082-1839c3c92f6e": {
					"simStepIds": [
						"b424dfeb-4e45-4759-941d-4711a9cc0667"
					]
				},
				"830deb71-319b-4de5-8c37-39775d009a81": {
					"simStepIds": [
						"774bc186-4156-486d-84c8-71277f22ecd7"
					]
				},
				"233e59c3-7be1-41e3-a6f2-5a96b8f559dd": {
					"simStepIds": [
						"099a910b-24af-46ce-bb72-883088d22a6b"
					]
				},
				"59572d93-14bd-4f6e-88ae-77e213cc6965": {
					"simStepIds": [
						"ad0e4ac0-5a72-430e-9b5e-8f414884b56b"
					]
				},
				"3b657019-d111-4eda-8083-3bcec130ceb7": {
					"simStepIds": [
						"901f7846-1317-4de1-b4a1-15ce3b7695f9"
					]
				},
				"42f3fb35-4064-477a-bdd7-5b0bb00e7c90": {
					"simStepIds": [
						"a6fc19d8-7445-4179-8206-2c6306f73ffc"
					]
				},
				"454e29ca-d494-43d7-b568-958f85a45075": {
					"simStepIds": [
						"5bc2b6e6-166c-47f2-823f-85806a557a18"
					]
				}
			},
			"isAIGenerated": true,
			"keywords": "sf::Sound, sf::Music, sf::SoundBuffer, play",
			"generationPrompt": "Play audio sounds and stream music",
			"generationKeywords": "sf::Sound, sf::Music, sf::SoundBuffer, play"
		},
		"Apply custom visual effects using shaders": {
			"name": "Apply custom visual effects using shaders",
			"simSteps": [
				{
					"simStepId": "62834f02-8cf2-4c30-a082-c0c36f3b0165",
					"diagramNodeId": "c48172ff-f50d-49fc-94c9-35c9bfea68ef",
					"simStepLabel": "Load Shader From File",
					"simStepDescription": "The application starts by checking if shaders are available. Then, it attempts to load a custom GLSL fragment shader from a file ('pixelate.frag') into an `sf::Shader` object. This function reads the shader source code, compiles it, and links it into a shader program managed by the `sf::Shader` instance.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/shader/Shader.cpp",
						"startLine": "283",
						"endLine": "285",
						"relevantVariables": [
							"shader",
							"shader.loadFromFile"
						]
					},
					"inputDataExample": "{\"fragmentShaderPath\": \"resources/pixelate.frag\", \"shaderType\": \"sf::Shader::Type::Fragment\"}",
					"outputDataExample": "{\"success\": true, \"shaderObject\": {\"nativeHandle\": 1}}"
				},
				{
					"simStepId": "169d255d-1043-45b7-b738-ac5c798dc2ce",
					"diagramNodeId": "cf01911c-3c8b-4d74-93a1-08f4b6660091",
					"simStepLabel": "Transfer Shader Object",
					"simStepDescription": "The successfully created `sf::Shader` object is moved into the constructor of the `Pixelate` effect class. This encapsulates the shader logic within the specific effect that will use it.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "examples/shader/Shader.cpp",
						"startLine": "287",
						"endLine": "287",
						"relevantVariables": [
							"std::move(shader)",
							"Pixelate"
						]
					},
					"inputDataExample": "{\"shaderObject\": {\"nativeHandle\": 1}}",
					"outputDataExample": "{\"shaderObject\": {\"nativeHandle\": 1}}"
				},
				{
					"simStepId": "ac954dfc-f8ed-4ef1-ba45-0294f47650dc",
					"diagramNodeId": "c1485b8e-90fa-490a-bdaf-6d82816b6545",
					"simStepLabel": "Configure Initial Shader Uniform",
					"simStepDescription": "Inside the `Pixelate` effect's constructor, an initial uniform variable named 'texture' is set. It is assigned the special value `sf::Shader::CurrentTexture`, which instructs the shader to use the texture of the object being drawn at render time.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/shader/Shader.cpp",
						"startLine": "41",
						"endLine": "41",
						"relevantVariables": [
							"m_shader",
							"m_shader.setUniform",
							"sf::Shader::CurrentTexture"
						]
					},
					"inputDataExample": "{\"uniformName\": \"texture\", \"value\": \"sf::Shader::CurrentTexture\"}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "2de3f6f3-44ad-48d5-9cf2-323b660aeb7d",
					"diagramNodeId": "98021966-659e-4ab5-b299-ab0d659aedcc",
					"simStepLabel": "Transmit CurrentTexture Uniform Data",
					"simStepDescription": "The name of the uniform ('texture') and the `CurrentTextureType` value are passed to the `setUniform` method. This configures an internal mapping within the `sf::Shader` object to handle this special texture binding during the draw call.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Graphics/Shader.cpp",
						"startLine": "683",
						"endLine": "691",
						"relevantVariables": [
							"name",
							"CurrentTextureType"
						]
					},
					"inputDataExample": "{\"uniformName\": \"texture\", \"valueType\": \"CurrentTextureType\"}",
					"outputDataExample": "{\"uniformName\": \"texture\", \"valueType\": \"CurrentTextureType\"}"
				},
				{
					"simStepId": "d20cecc3-986d-4ec2-94fd-98e57b580531",
					"diagramNodeId": "3a731d50-712d-4ea0-aed0-0db48cc5f34a",
					"simStepLabel": "Update Dynamic Uniform in Game Loop",
					"simStepDescription": "In each frame of the main loop, the `update` method of the current effect is called. For the `Pixelate` effect, this dynamically calculates a `pixel_threshold` value based on the mouse's X and Y coordinates and sends it to the shader via `setUniform`. This allows the visual effect to be interactive.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/shader/Shader.cpp",
						"startLine": "46",
						"endLine": "47",
						"relevantVariables": [
							"m_shader",
							"m_shader.setUniform",
							"pixel_threshold",
							"x",
							"y"
						]
					},
					"inputDataExample": "{\"time\": 3.45, \"x\": 0.4, \"y\": 0.6}",
					"outputDataExample": "{}"
				},
				{
					"simStepId": "66d27252-aebe-4039-9605-baa2bf7ffddc",
					"diagramNodeId": "b2617704-3dd1-4578-b03c-d7ea84b3e367",
					"simStepLabel": "Transmit Float Uniform Data",
					"simStepDescription": "The calculated float value for the `pixel_threshold` uniform is transmitted to the `sf::Shader` object. This function finds the uniform's location in the shader program and uses an OpenGL call (`glUniform1f`) to upload the new value to the GPU.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Graphics/Shader.cpp",
						"startLine": "531",
						"endLine": "536",
						"relevantVariables": [
							"name",
							"x",
							"binder",
							"GLEXT_glUniform1f"
						]
					},
					"inputDataExample": "{\"uniformName\": \"pixel_threshold\", \"value\": 0.03333}",
					"outputDataExample": "{\"uniformName\": \"pixel_threshold\", \"value\": 0.03333}"
				},
				{
					"simStepId": "41a0c2c6-b4b4-454e-ac89-3a458c6ab9a9",
					"diagramNodeId": "4733a521-4569-4cb6-9dbd-69f324158e9c",
					"simStepLabel": "Prepare Render States for Drawing",
					"simStepDescription": "When it's time to draw the effect, the `draw` method is called. It configures an `sf::RenderStates` object by assigning its `shader` member a pointer to the `Pixelate` effect's `sf::Shader` instance. This object bundles all the necessary states for rendering.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/shader/Shader.cpp",
						"startLine": "51",
						"endLine": "51",
						"relevantVariables": [
							"states",
							"states.shader",
							"m_shader"
						]
					},
					"inputDataExample": "{\"states\": {\"blendMode\": \"BlendAlpha\", \"transform\": \"Identity\", \"texture\": null, \"shader\": null}}",
					"outputDataExample": "{\"states\": {\"blendMode\": \"BlendAlpha\", \"transform\": \"Identity\", \"texture\": null, \"shader\": {\"nativeHandle\": 1}}}"
				},
				{
					"simStepId": "513e2afb-4256-484a-ad8b-9b01b3225a77",
					"diagramNodeId": "10b1a0b6-ce79-4a27-894b-8a768b9055d5",
					"simStepLabel": "Pass Render States to Draw Call",
					"simStepDescription": "The configured `sf::RenderStates` object, now containing the pointer to the custom shader, is passed as an argument to the `target.draw()` method along with the drawable object (an `sf::Sprite`). This transfers the full rendering context to the render target.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "examples/shader/Shader.cpp",
						"startLine": "52",
						"endLine": "52",
						"relevantVariables": [
							"target",
							"target.draw",
							"states"
						]
					},
					"inputDataExample": "{\"drawable\": \"sf::Sprite\", \"states\": {\"shader\": {\"nativeHandle\": 1}}}",
					"outputDataExample": "{\"drawable\": \"sf::Sprite\", \"states\": {\"shader\": {\"nativeHandle\": 1}}}"
				},
				{
					"simStepId": "60c95fda-2d0f-4852-85f8-f077f4291b32",
					"diagramNodeId": "5be5dbf4-e09e-4e40-ad9d-c9f82a7421d2",
					"simStepLabel": "Render Target Applies Shader",
					"simStepDescription": "The `RenderTarget` receives the drawable and the render states. The sprite's `draw` method is called, which combines the sprite's own transform with the render states, sets the texture, and calls the low-level draw function. This function is responsible for binding the specified shader and texture before issuing the actual draw command to the GPU.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Graphics/Sprite.cpp",
						"startLine": "117",
						"endLine": "124",
						"relevantVariables": [
							"target",
							"states",
							"states.transform",
							"states.texture",
							"target.draw"
						]
					},
					"inputDataExample": "{\"target\": \"sf::RenderWindow\", \"states_from_effect\": {\"shader\": {\"nativeHandle\": 1}}}",
					"outputDataExample": "{\"final_states\": {\"transform\": \"Matrix[...]]\", \"texture\": {\"nativeHandle\": 2}, \"shader\": {\"nativeHandle\": 1}}}"
				},
				{
					"simStepId": "366b340e-358f-40c2-bb1a-7a9c44e80c3e",
					"diagramNodeId": "ec495e22-c22d-4481-a9ba-b2651164855d",
					"simStepLabel": "Send Draw Command to GPU",
					"simStepDescription": "The CPU sends the final, processed rendering data to the GPU. This includes the sprite's vertex data, the texture to be sampled, and the compiled shader program to be executed for each pixel.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "src/SFML/Graphics/Sprite.cpp",
						"startLine": "124",
						"endLine": "124",
						"relevantVariables": [
							"target.draw"
						]
					},
					"inputDataExample": "{\"vertices\": [{\"position\":[0,0], \"color\":[255,255,255,255], \"texCoords\":[0,0]}, ...], \"primitiveType\": \"TriangleStrip\", \"states\": {\"shader\": {\"nativeHandle\": 1}}}",
					"outputDataExample": "{\"vertices\": [{\"position\":[0,0], \"color\":[255,255,255,255], \"texCoords\":[0,0]}, ...], \"primitiveType\": \"TriangleStrip\", \"states\": {\"shader\": {\"nativeHandle\": 1}}}"
				},
				{
					"simStepId": "c8eb3f05-fc35-4fe0-971d-38c484e83cfa",
					"diagramNodeId": "f997bd47-7dc3-4346-b71e-90897b7d7c7f",
					"simStepLabel": "GPU Executes Fragment Shader",
					"simStepDescription": "The GPU's graphics pipeline executes the fragment shader for each pixel of the sprite. The shader code reads the `pixel_threshold` uniform, calculates a new texture coordinate by rounding the original one, samples the color from this new coordinate in the 'texture' uniform, and outputs the final pixel color to the screen, creating the pixelated effect.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/shader/resources/pixelate.frag",
						"startLine": "1",
						"endLine": "15",
						"relevantVariables": [
							"pixel_threshold",
							"texture",
							"gl_TexCoord",
							"texture2D",
							"gl_FragColor"
						]
					},
					"inputDataExample": "{\"gl_FragCoord\": [150.5, 220.2], \"uniform_pixel_threshold\": 0.03333, \"uniform_texture\": \"sampler2D\"}",
					"outputDataExample": "{\"gl_FragColor\": [0.85, 0.23, 0.31, 1.0]}"
				}
			],
			"description": "<ul><li>SFML allows for advanced, hardware-accelerated visual effects by providing a simple interface for GLSL shaders</li><li>- Load custom vertex, geometry, and fragment shaders from files or memory</li><li>- Apply shaders when drawing any object to achieve effects like blur, pixelation, color manipulation, or complex vertex deformations</li><li>- Pass dynamic parameters (uniforms) from the C++ code to the shader at runtime to create animated and interactive effects</li></ul>",
			"simulationNodesAndEdges": {
