					"diagramNodeId": "0dbb740d-192d-4aa2-9dd3-52e450713115",
					"simStepLabel": "Client Flow: Configure Server Address",
					"simStepDescription": "The client must have the IP address and port of the server it wants to connect to. This is typically configured by the user or hardcoded.",
					"isEdge": 1,
					"sourceCodeMapping": {
