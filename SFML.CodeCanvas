					"diagramNodeId": "4f862b91-e2a5-4b1e-9ea7-ed7d0e11e7c3",
					"simStepLabel": "Transmit Delta Time",
					"simStepDescription": "The calculated floating-point `deltaTime` is now available for use in all frame-dependent calculations.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "examples/tennis/Tennis.cpp",
