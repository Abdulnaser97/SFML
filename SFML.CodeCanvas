					"diagramNodeId": "ce2e96f9-64d6-4bab-b76b-88f14d92c368",
					"simStepLabel": "Client Flow: Receive Server Message",
					"simStepDescription": "The client calls `receive()` on the connected socket to wait for data from the server. This call blocks until the server sends its welcome message.",
					"isEdge": 0,
					"sourceCodeMapping": {
