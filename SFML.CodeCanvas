		},
		"49dfa503-b3b5-4649-a226-4c63fc77acbb": {
			"path": "49dfa503-b3b5-4649-a226-4c63fc77acbb",
			"cellName": "Sound Flow: Load Audio File into SoundBuffer - SoundBuffer.hpp:L84-93",
			"cellId": "49dfa503-b3b5-4649-a226-4c63fc77acbb",
			"visible": true,
			"parentCellId": "d5df1ee4-c2a0-4179-b234-380821f12790"
		},
		"include/SFML/Audio/SoundBuffer.hpp-simstep-dea62be1-5e72-45c3-b097-8c7140a16ebe": {
			"path": "include/SFML/Audio/SoundBuffer.hpp-simstep-dea62be1-5e72-45c3-b097-8c7140a16ebe",
			"fileName": "SoundBuffer.hpp",
			"wiki": "An audio file is loaded from disk into a `sf::SoundBuffer`. This involves opening the file, decoding its format (e.g., WAV, FLAC, OGG) using an appropriate `SoundFileReader`, and storing the entire set of raw audio samples in memory.",
			"cellName": "Sound Flow: Load Audio File into SoundBuffer - SoundBuffer.hpp:L84-93",
			"cellId": "49dfa503-b3b5-4649-a226-4c63fc77acbb",
			"visible": true,
			"startLine": 84,
			"endLine": 93,
			"parentCellId": "d5df1ee4-c2a0-4179-b234-380821f12790",
			"parentPath": "include/SFML/Audio/SoundBuffer.hpp"
		},
		"35bfb4ce-7c18-430a-a2d2-8bf1ee729fa2": {
			"path": "35bfb4ce-7c18-430a-a2d2-8bf1ee729fa2",
			"cellName": "Sound Flow: Initialize Sound Object - Sound.hpp:L54-57",
			"cellId": "35bfb4ce-7c18-430a-a2d2-8bf1ee729fa2",
			"visible": true,
			"parentCellId": "1393ab98-b381-422d-ac9e-949e9397b099"
		},
		"include/SFML/Audio/Sound.hpp-simstep-749b926d-aba7-4e40-a92a-b86bdfb8b7e1": {
			"path": "include/SFML/Audio/Sound.hpp-simstep-749b926d-aba7-4e40-a92a-b86bdfb8b7e1",
			"fileName": "Sound.hpp",
			"wiki": "`sf::Sound` is initialized with the provided `sf::SoundBuffer`. It sets itself up as a playable sound source, connecting to the underlying audio backend (miniaudio) and preparing for playback without actually starting.",
			"cellName": "Sound Flow: Initialize Sound Object - Sound.hpp:L54-57",
			"cellId": "35bfb4ce-7c18-430a-a2d2-8bf1ee729fa2",
			"visible": true,
			"startLine": 54,
			"endLine": 57,
			"parentCellId": "1393ab98-b381-422d-ac9e-949e9397b099",
			"parentPath": "include/SFML/Audio/Sound.hpp"
		},
		"45d9d0a9-9d03-4a07-a935-2e42c6844e55": {
			"path": "45d9d0a9-9d03-4a07-a935-2e42c6844e55",
			"cellName": "Sound Flow: Execute Sound Playback - Sound.cpp:L218-233",
			"cellId": "45d9d0a9-9d03-4a07-a935-2e42c6844e55",
			"visible": true,
			"parentCellId": "5bec9b40-9bd1-4c1e-9f8c-dfd9b1c4a146"
		},
		"src/SFML/Audio/Sound.cpp-simstep-23421b72-366a-4411-ac00-294c0f8b9fb4": {
			"path": "src/SFML/Audio/Sound.cpp-simstep-23421b72-366a-4411-ac00-294c0f8b9fb4",
			"fileName": "Sound.cpp",
			"wiki": "The `play()` method in `sf::Sound` triggers the audio backend (`miniaudio`) to start playing the sound. The backend reads the audio samples from the referenced `sf::SoundBuffer` and sends them to the active audio playback device.",
			"cellName": "Sound Flow: Execute Sound Playback - Sound.cpp:L218-233",
			"cellId": "45d9d0a9-9d03-4a07-a935-2e42c6844e55",
			"visible": true,
			"startLine": 218,
			"endLine": 233,
			"parentCellId": "5bec9b40-9bd1-4c1e-9f8c-dfd9b1c4a146",
			"parentPath": "src/SFML/Audio/Sound.cpp"
		},
		"ded08383-032b-4f02-8082-1839c3c92f6e": {
			"path": "ded08383-032b-4f02-8082-1839c3c92f6e",
			"cellName": "Music Flow: Open Music File for Streaming - Music.hpp:L87-91",
			"cellId": "ded08383-032b-4f02-8082-1839c3c92f6e",
			"visible": true,
			"parentCellId": "1587ef9b-d9c1-42f4-88ec-17bcc9cb0fa8"
		},
		"include/SFML/Audio/Music.hpp-simstep-b424dfeb-4e45-4759-941d-4711a9cc0667": {
			"path": "include/SFML/Audio/Music.hpp-simstep-b424dfeb-4e45-4759-941d-4711a9cc0667",
			"fileName": "Music.hpp",
			"wiki": "A `sf::Music` object is created with a path to a long audio file. Unlike `sf::SoundBuffer`, this does not load the entire file into memory. Instead, it opens the file, reads its header to get format information (duration, sample rate, channels), and prepares for on-the-fly streaming.",
			"cellName": "Music Flow: Open Music File for Streaming - Music.hpp:L87-91",
			"cellId": "ded08383-032b-4f02-8082-1839c3c92f6e",
			"visible": true,
			"startLine": 87,
			"endLine": 91,
			"parentCellId": "1587ef9b-d9c1-42f4-88ec-17bcc9cb0fa8",
			"parentPath": "include/SFML/Audio/Music.hpp"
		},
		"830deb71-319b-4de5-8c37-39775d009a81": {
			"path": "830deb71-319b-4de5-8c37-39775d009a81",
			"cellName": "Music Flow: Start Streaming Thread - SoundStream.cpp:L274-289",
			"cellId": "830deb71-319b-4de5-8c37-39775d009a81",
			"visible": true,
			"parentCellId": "6854fe57-3e7a-4fa6-b8ac-7256aec2dfca"
		},
		"src/SFML/Audio/SoundStream.cpp-simstep-774bc186-4156-486d-84c8-71277f22ecd7": {
			"path": "src/SFML/Audio/SoundStream.cpp-simstep-774bc186-4156-486d-84c8-71277f22ecd7",
			"fileName": "SoundStream.cpp",
			"wiki": "`sf::Music` inherits from `sf::SoundStream`. Its `play()` method initializes and starts the underlying audio backend, which operates in a separate thread. This thread is responsible for continuously requesting and playing chunks of audio data without blocking the main application.",
			"cellName": "Music Flow: Start Streaming Thread - SoundStream.cpp:L274-289",
			"cellId": "830deb71-319b-4de5-8c37-39775d009a81",
			"visible": true,
			"startLine": 274,
			"endLine": 289,
			"parentCellId": "6854fe57-3e7a-4fa6-b8ac-7256aec2dfca",
			"parentPath": "src/SFML/Audio/SoundStream.cpp"
		},
		"233e59c3-7be1-41e3-a6f2-5a96b8f559dd": {
			"path": "233e59c3-7be1-41e3-a6f2-5a96b8f559dd",
			"cellName": "Music Flow: Provide Audio Data Chunk - Music.cpp:L255-277",
			"cellId": "233e59c3-7be1-41e3-a6f2-5a96b8f559dd",
			"visible": true,
			"parentCellId": "611b2642-5beb-4ea6-bdc8-871cb9a85c3e"
		},
		"src/SFML/Audio/Music.cpp-simstep-099a910b-24af-46ce-bb72-883088d22a6b": {
			"path": "src/SFML/Audio/Music.cpp-simstep-099a910b-24af-46ce-bb72-883088d22a6b",
			"fileName": "Music.cpp",
			"wiki": "The `sf::Music` class's implementation of `onGetData` is called. It reads a small chunk of audio data from the file on disk, fills the provided `Chunk` structure with the new samples, and returns `true` to the backend, indicating that the stream is ongoing. This process repeats until the file ends or is stopped.",
			"cellName": "Music Flow: Provide Audio Data Chunk - Music.cpp:L255-277",
			"cellId": "233e59c3-7be1-41e3-a6f2-5a96b8f559dd",
			"visible": true,
			"startLine": 255,
			"endLine": 277,
			"parentCellId": "611b2642-5beb-4ea6-bdc8-871cb9a85c3e",
			"parentPath": "src/SFML/Audio/Music.cpp"
		},
		"59572d93-14bd-4f6e-88ae-77e213cc6965": {
