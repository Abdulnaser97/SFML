		"b90cef3a-73ba-4af5-bc7e-a4749dc7b216": {
			"path": "b90cef3a-73ba-4af5-bc7e-a4749dc7b216",
			"cellName": "Drawable.hpp",
			"cellId": "b90cef3a-73ba-4af5-bc7e-a4749dc7b216",
			"visible": true,
			"parentCellId": "5cd1a142-9555-4c25-b56f-b766738ee3de"
		},
		"f461f7c7-0088-453e-813e-2e6ebbe44f44": {
			"path": "f461f7c7-0088-453e-813e-2e6ebbe44f44",
			"cellName": "RectangleShape.hpp",
			"cellId": "f461f7c7-0088-453e-813e-2e6ebbe44f44",
			"visible": true,
			"parentCellId": "5cd1a142-9555-4c25-b56f-b766738ee3de"
		},
		"8ecfe12f-dd0a-4e10-937d-8d5fb586a851": {
			"path": "8ecfe12f-dd0a-4e10-937d-8d5fb586a851",
			"cellName": "Shape.hpp",
			"cellId": "8ecfe12f-dd0a-4e10-937d-8d5fb586a851",
			"visible": true,
			"parentCellId": "5cd1a142-9555-4c25-b56f-b766738ee3de"
		},
		"479535b8-753e-48d4-b117-8d11b1064299": {
			"path": "479535b8-753e-48d4-b117-8d11b1064299",
			"cellName": "Render Sprite Flow: Load Texture - Texture.hpp:L120",
			"cellId": "479535b8-753e-48d4-b117-8d11b1064299",
			"visible": true,
			"parentCellId": "496ac7ac-5c67-4515-99e3-3133a794c744"
		},
		"include/SFML/Graphics/Texture.hpp-simstep-2abd29f2-f83a-4a95-b205-e1ae21abf23e": {
			"path": "include/SFML/Graphics/Texture.hpp-simstep-2abd29f2-f83a-4a95-b205-e1ae21abf23e",
			"fileName": "Texture.hpp",
			"wiki": "A `sf::Texture` object is created by loading an image from a file. This process involves reading the file from disk, decoding the image format (e.g., PNG, JPG), and uploading the raw pixel data to the GPU's memory for efficient rendering.",
			"cellName": "Render Sprite Flow: Load Texture - Texture.hpp:L120",
			"cellId": "479535b8-753e-48d4-b117-8d11b1064299",
			"visible": true,
			"startLine": 120,
			"endLine": 120,
			"parentCellId": "496ac7ac-5c67-4515-99e3-3133a794c744",
			"parentPath": "include/SFML/Graphics/Texture.hpp"
		},
		"dd22cb94-f4c2-48b0-a266-d72e13055fd2": {
			"path": "dd22cb94-f4c2-48b0-a266-d72e13055fd2",
			"cellName": "Render Sprite Flow: Create Sprite - Sprite.hpp:L57",
			"cellId": "dd22cb94-f4c2-48b0-a266-d72e13055fd2",
			"visible": true,
			"parentCellId": "53ee33a7-7c04-4e9a-a006-40b7573a253a"
		},
		"include/SFML/Graphics/Sprite.hpp-simstep-a3f6b0f3-fe59-4514-aa39-1f1555bf3c75": {
			"path": "include/SFML/Graphics/Sprite.hpp-simstep-a3f6b0f3-fe59-4514-aa39-1f1555bf3c75",
			"fileName": "Sprite.hpp",
			"wiki": "An `sf::Sprite` object is instantiated. It acts as a lightweight object that can be drawn to the screen. Internally, it holds the pointer to its texture and defines a geometric shape (a quad of 4 vertices) that maps to the texture or a sub-rectangle of it.",
			"cellName": "Render Sprite Flow: Create Sprite - Sprite.hpp:L57",
			"cellId": "dd22cb94-f4c2-48b0-a266-d72e13055fd2",
			"visible": true,
			"startLine": 57,
			"endLine": 57,
			"parentCellId": "53ee33a7-7c04-4e9a-a006-40b7573a253a",
			"parentPath": "include/SFML/Graphics/Sprite.hpp"
		},
		"d919a102-9b4b-4967-86a2-d95f264a0884": {
			"path": "d919a102-9b4b-4967-86a2-d95f264a0884",
			"cellName": "Render Sprite Flow: Draw Sprite on Render Target - Sprite.hpp:L211",
			"cellId": "d919a102-9b4b-4967-86a2-d95f264a0884",
			"visible": true,
			"parentCellId": "53ee33a7-7c04-4e9a-a006-40b7573a253a"
		},
		"include/SFML/Graphics/Sprite.hpp-simstep-4c64ab82-66bb-40dc-b59e-ba3d8e045755": {
			"path": "include/SFML/Graphics/Sprite.hpp-simstep-4c64ab82-66bb-40dc-b59e-ba3d8e045755",
			"fileName": "Sprite.hpp",
			"wiki": "The `RenderTarget` (e.g., `sf::RenderWindow`) invokes the sprite's own `draw` method. This method applies the sprite's transformations (position, rotation, scale) to its vertices, sets the appropriate render states (including binding its texture), and issues a command to the GPU to draw the vertices.",
			"cellName": "Render Sprite Flow: Draw Sprite on Render Target - Sprite.hpp:L211",
			"cellId": "d919a102-9b4b-4967-86a2-d95f264a0884",
			"visible": true,
			"startLine": 211,
			"endLine": 211,
			"parentCellId": "53ee33a7-7c04-4e9a-a006-40b7573a253a",
			"parentPath": "include/SFML/Graphics/Sprite.hpp"
		},
		"82467da7-812c-4c91-be3f-0cfc32d37098": {
			"path": "82467da7-812c-4c91-be3f-0cfc32d37098",
			"cellName": "Render Text Flow: Load Font - Font.hpp:L101",
			"cellId": "82467da7-812c-4c91-be3f-0cfc32d37098",
			"visible": true,
			"parentCellId": "e9c91b78-d703-405f-ba92-c0f4a9728453"
		},
		"include/SFML/Graphics/Font.hpp-simstep-17f1f2bc-183c-4479-aef4-f7f73ba8648a": {
			"path": "include/SFML/Graphics/Font.hpp-simstep-17f1f2bc-183c-4479-aef4-f7f73ba8648a",
			"fileName": "Font.hpp",
			"wiki": "A `sf::Font` object is created by loading a font file (e.g., TTF). This initializes the FreeType font library, parses the font file, and makes the font's metadata and glyph data available for rendering.",
			"cellName": "Render Text Flow: Load Font - Font.hpp:L101",
			"cellId": "82467da7-812c-4c91-be3f-0cfc32d37098",
			"visible": true,
			"startLine": 101,
			"endLine": 101,
			"parentCellId": "e9c91b78-d703-405f-ba92-c0f4a9728453",
			"parentPath": "include/SFML/Graphics/Font.hpp"
		},
		"f2347687-d63d-4bfb-94dd-e2f444ab4449": {
			"path": "f2347687-d63d-4bfb-94dd-e2f444ab4449",
			"cellName": "Render Text Flow: Create Text and Generate Geometry - Text.hpp:L159",
			"cellId": "f2347687-d63d-4bfb-94dd-e2f444ab4449",
			"visible": true,
			"parentCellId": "36643504-3bc6-4279-a041-63f476d04b79"
		},
		"include/SFML/Graphics/Text.hpp-simstep-f618fa92-08b0-42a9-b324-2d8e245b9716": {
			"path": "include/SFML/Graphics/Text.hpp-simstep-f618fa92-08b0-42a9-b324-2d8e245b9716",
			"fileName": "Text.hpp",
			"wiki": "An `sf::Text` object is created. It uses the provided font to process the input string. For each character, it requests the corresponding glyph from the `sf::Font`. The font rasterizes the glyph if it's not already available and stores it in an internal texture atlas. The `sf::Text` object then computes the vertices and texture coordinates for all glyphs to form the final text geometry.",
			"cellName": "Render Text Flow: Create Text and Generate Geometry - Text.hpp:L159",
			"cellId": "f2347687-d63d-4bfb-94dd-e2f444ab4449",
			"visible": true,
			"startLine": 159,
			"endLine": 159,
			"parentCellId": "36643504-3bc6-4279-a041-63f476d04b79",
			"parentPath": "include/SFML/Graphics/Text.hpp"
		},
		"9fa07ae8-4ada-4614-bf05-785572eec26c": {
			"path": "9fa07ae8-4ada-4614-bf05-785572eec26c",
			"cellName": "Render Text Flow: Draw Text on Render Target - Drawable.hpp:L76",
			"cellId": "9fa07ae8-4ada-4614-bf05-785572eec26c",
			"visible": true,
			"parentCellId": "b90cef3a-73ba-4af5-bc7e-a4749dc7b216"
		},
		"include/SFML/Graphics/Drawable.hpp-simstep-cf6a31ef-a651-4a70-8c04-3d7e6e45f57a": {
			"path": "include/SFML/Graphics/Drawable.hpp-simstep-cf6a31ef-a651-4a70-8c04-3d7e6e45f57a",
			"fileName": "Drawable.hpp",
			"wiki": "The `RenderTarget` calls the `sf::Text` object's virtual `draw` method. This method sets the render states, including binding the font's internal glyph texture atlas, and issues a GPU command to draw the text's vertices.",
			"cellName": "Render Text Flow: Draw Text on Render Target - Drawable.hpp:L76",
			"cellId": "9fa07ae8-4ada-4614-bf05-785572eec26c",
			"visible": true,
			"startLine": 76,
			"endLine": 76,
			"parentCellId": "b90cef3a-73ba-4af5-bc7e-a4749dc7b216",
			"parentPath": "include/SFML/Graphics/Drawable.hpp"
		},
		"eb2bcac1-8c99-4fc2-8b7b-1e6b2d5e778f": {
			"path": "eb2bcac1-8c99-4fc2-8b7b-1e6b2d5e778f",
			"cellName": "Render Shape Flow: Create Shape - RectangleShape.hpp:L51",
			"cellId": "eb2bcac1-8c99-4fc2-8b7b-1e6b2d5e778f",
			"visible": true,
			"parentCellId": "f461f7c7-0088-453e-813e-2e6ebbe44f44"
		},
		"include/SFML/Graphics/RectangleShape.hpp-simstep-1bd71095-ed6b-4ceb-bb21-6f791111b48c": {
			"path": "include/SFML/Graphics/RectangleShape.hpp-simstep-1bd71095-ed6b-4ceb-bb21-6f791111b48c",
			"fileName": "RectangleShape.hpp",
			"wiki": "A concrete shape object, such as `sf::RectangleShape`, is instantiated. The constructor initializes its geometric properties (e.g., size). The base `sf::Shape` class manages common properties like color and texture, as well as the internal vertex array.",
			"cellName": "Render Shape Flow: Create Shape - RectangleShape.hpp:L51",
			"cellId": "eb2bcac1-8c99-4fc2-8b7b-1e6b2d5e778f",
			"visible": true,
			"startLine": 51,
			"endLine": 51,
			"parentCellId": "f461f7c7-0088-453e-813e-2e6ebbe44f44",
			"parentPath": "include/SFML/Graphics/RectangleShape.hpp"
		},
		"c981ee26-caaf-452b-84a1-5758b733264d": {
			"path": "c981ee26-caaf-452b-84a1-5758b733264d",
			"cellName": "Render Shape Flow: Update Shape's Internal Vertices - Shape.hpp:L344-347",
			"cellId": "c981ee26-caaf-452b-84a1-5758b733264d",
			"visible": true,
			"parentCellId": "8ecfe12f-dd0a-4e10-937d-8d5fb586a851"
		},
		"include/SFML/Graphics/Shape.hpp-simstep-22421510-6e25-411b-99a5-67c8862d8c00": {
			"path": "include/SFML/Graphics/Shape.hpp-simstep-22421510-6e25-411b-99a5-67c8862d8c00",
			"fileName": "Shape.hpp",
			"wiki": "Calling a method like `setFillColor` updates the corresponding property in the `sf::Shape` base class. This triggers an update of the internal vertex array, changing the color attribute of each vertex that makes up the shape's fill area.",
			"cellName": "Render Shape Flow: Update Shape's Internal Vertices - Shape.hpp:L344-347",
			"cellId": "c981ee26-caaf-452b-84a1-5758b733264d",
			"visible": true,
			"startLine": 344,
			"endLine": 347,
			"parentCellId": "8ecfe12f-dd0a-4e10-937d-8d5fb586a851",
			"parentPath": "include/SFML/Graphics/Shape.hpp"
		},
		"df4f0b98-0841-4501-9389-1317caf9cc03": {
			"path": "df4f0b98-0841-4501-9389-1317caf9cc03",
			"cellName": "Render Shape Flow: Draw Shape on Render Target - Shape.hpp:L340",
			"cellId": "df4f0b98-0841-4501-9389-1317caf9cc03",
			"visible": true,
			"parentCellId": "8ecfe12f-dd0a-4e10-937d-8d5fb586a851"
		},
		"include/SFML/Graphics/Shape.hpp-simstep-2e122a80-8632-4b4d-afc1-97927f67ae87": {
			"path": "include/SFML/Graphics/Shape.hpp-simstep-2e122a80-8632-4b4d-afc1-97927f67ae87",
			"fileName": "Shape.hpp",
			"wiki": "The `RenderTarget` calls the shape's `draw` method. This method draws the vertices for the shape's fill area and, if an outline is defined, also draws the vertices for the outline.",
			"cellName": "Render Shape Flow: Draw Shape on Render Target - Shape.hpp:L340",
			"cellId": "df4f0b98-0841-4501-9389-1317caf9cc03",
			"visible": true,
			"startLine": 340,
			"endLine": 340,
			"parentCellId": "8ecfe12f-dd0a-4e10-937d-8d5fb586a851",
			"parentPath": "include/SFML/Graphics/Shape.hpp"
		},
		"5fd6ccd7-d607-408d-aa41-dbb1980dea5f": {
			"path": "5fd6ccd7-d607-408d-aa41-dbb1980dea5f",
