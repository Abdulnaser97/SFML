						"endLine": "163",
						"relevantVariables": [
							"deltaTime"
						]
					},
					"inputDataExample": "{\"deltaTime\": 0.016667}",
					"outputDataExample": "{\"deltaTime\": 0.016667}"
				},
				{
					"simStepId": "5e786162-3d47-4238-8807-3215fa882a81",
					"diagramNodeId": "898b88d1-70cd-4441-a047-eedceb02a31e",
					"simStepLabel": "Apply Delta Time to Game Logic",
					"simStepDescription": "The `deltaTime` is used to update the position of a game object. By multiplying the object's speed by `deltaTime`, its movement becomes independent of the frame rate, resulting in smooth and consistent motion across different hardware.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "examples/tennis/Tennis.cpp",
						"startLine": "187",
