					},
					"inputDataExample": "{\"elapsed_time_object\": {\"microseconds\": 16667}}",
					"outputDataExample": "{\"elapsed_time_object\": {\"microseconds\": 16667}}"
				},
				{
					"simStepId": "f6776568-6b25-4781-b146-50faa0028f1e",
					"diagramNodeId": "030bf8ba-42c2-4526-b4fa-6b953a7a93ac",
					"simStepLabel": "Convert Time to Seconds",
					"simStepDescription": "The `.asSeconds()` method is called on the `sf::Time` object. This converts the duration, internally stored in microseconds, into a floating-point number representing the equivalent time in seconds. This float value is ideal for physics and animation calculations.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "include/SFML/System/Time.hpp",
						"startLine": "63",
