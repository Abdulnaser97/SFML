				},
				{
					"simStepId": "6d2ee841-360e-4d21-a974-7b5e52300ad3",
					"diagramNodeId": "4e62f621-f96f-4050-904a-e345d70a366d",
					"simStepLabel": "Client Flow: Create TCP Socket",
					"simStepDescription": "The client application initializes an `sf::TcpSocket` object to communicate with a server.",
					"isEdge": 0,
